<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <AssemblyName>Telemavix.Cli</AssemblyName>
    <RootNamespace>Telemavix.Cli</RootNamespace>
    <ApplicationIcon>Assets\Telemavix.Cli.ico</ApplicationIcon>

    <AssemblyTitle>Telemavix Studio CLI</AssemblyTitle>
