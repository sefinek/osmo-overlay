<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OsmoOverlay.Cameras.GoPro</AssemblyName>
    <RootNamespace>OsmoOverlay.Cameras.GoPro</RootNamespace>

    <AssemblyTitle>OsmoOverlay GoPro</AssemblyTitle>
