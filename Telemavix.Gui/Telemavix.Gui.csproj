<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <AssemblyName>Telemavix</AssemblyName>
    <RootNamespace>Telemavix.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Telemavix.ico</ApplicationIcon>

    <AssemblyTitle>Telemavix Studio</AssemblyTitle>
    <Description>Telemetry HUD overlay renderer for DJI Osmo Action, GoPro and Insta360 footage.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telemavix.Core\Telemavix.Core.csproj" />
    <ProjectReference Include="..\Telemavix.Cameras.Dji\Telemavix.Cameras.Dji.csproj" />
    <ProjectReference Include="..\Telemavix.Cameras.GoPro\Telemavix.Cameras.GoPro.csproj" />
    <ProjectReference Include="..\Telemavix.Drones.Dji\Telemavix.Drones.Dji.csproj" />
    <ProjectReference Include="..\Telemavix.Cameras.Insta360\Telemavix.Cameras.Insta360.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx"
                      LogicalName="Telemavix.Gui.Strings.resources"
                      StronglyTypedLanguage="C#"
                      StronglyTypedNamespace="Telemavix.Gui"
                      StronglyTypedClassName="Strings"
                      PublicClass="true"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" />
    <EmbeddedResource Update="Resources\Strings.pl.resx" LogicalName="Telemavix.Gui.Strings.pl.resources" />
    <Compile Include="$(IntermediateOutputPath)Strings.g.cs"
             Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(IntermediateOutputPath)Strings.g.cs')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\**\*.webp;Assets\*.png;Assets\*.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Telemavix.Gui.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
