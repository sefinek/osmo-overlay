<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>OsmoOverlay.Build</AssemblyName>
    <RootNamespace>OsmoOverlay.Build</RootNamespace>

    <Company>Sefinek</Company>
    <Product>OsmoOverlay</Product>
    <Title>OsmoOverlay Build</Title>
    <FileDescription>Builds the OsmoOverlay release packages for every supported OS and architecture.</FileDescription>
    <Copyright>© 2026 Sefinek. Licensed under MIT.</Copyright>
    <Authors>Sefinek</Authors>
    <NeutralLanguage>en-US</NeutralLanguage>

    <Version>0.1.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
