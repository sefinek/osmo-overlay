<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <AssemblyName>OsmoOverlay</AssemblyName>
    <RootNamespace>OsmoOverlay.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OsmoOverlay.ico</ApplicationIcon>

    <AssemblyTitle>OsmoOverlay</AssemblyTitle>
    <Description>Telemetry HUD overlay renderer for DJI Osmo Action and Insta360 footage.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsmoOverlay.Core\OsmoOverlay.Core.csproj" />
    <ProjectReference Include="..\OsmoOverlay.Cameras.Dji\OsmoOverlay.Cameras.Dji.csproj" />
    <ProjectReference Include="..\OsmoOverlay.Cameras.Insta360\OsmoOverlay.Cameras.Insta360.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx"
                      LogicalName="OsmoOverlay.Gui.Strings.resources"
                      StronglyTypedLanguage="C#"
                      StronglyTypedNamespace="OsmoOverlay.Gui"
                      StronglyTypedClassName="Strings"
                      PublicClass="true"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.g.cs" />
    <EmbeddedResource Update="Resources\Strings.pl.resx" LogicalName="OsmoOverlay.Gui.Strings.pl.resources" />
    <Compile Include="$(IntermediateOutputPath)Strings.g.cs"
             Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(IntermediateOutputPath)Strings.g.cs')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\OsmoOverlay.ico" />
    <AvaloniaResource Include="Assets\OsmoOverlay.png" />
    <AvaloniaResource Include="Assets\EmptyPreview.webp" />
    <AvaloniaResource Include="Assets\Welcome\*.webp" />
    <AvaloniaResource Include="Assets\Dialogs\*.webp" />
  </ItemGroup>

</Project>
