<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="220"
        x:Class="OsmoOverlay.Gui.ToolsWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#121214"
        Title="Tools">

	<Window.Styles>
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="Margin" Value="0,5" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Opacity" Value="0.4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,4,0,0" />
		</Style>
	</Window.Styles>

	<StackPanel Margin="20" Spacing="18">
		<StackPanel Spacing="4">
			<TextBlock Text="Fix color tags" Classes="infoLabel" Margin="0" />
			<TextBlock Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
			           Text="Vegas Pro's MP4 export can leave the color space (Rec.709) untagged even when the project is set correctly, which makes some players guess the wrong color matrix. This rewrites the tag with a lossless stream copy - no re-encode." />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Name="SelectColorTagFileButton" Content="Select file..." Click="OnSelectColorTagFileClick" />
			</StackPanel>
		</StackPanel>

		<StackPanel Spacing="4">
			<TextBlock Text="Remove metadata" Classes="infoLabel" Margin="0" />
			<TextBlock Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
			           Text="Saves a copy safe to share: removes the GPS/telemetry track, camera serial number, recording date, timecode and thumbnail. Picture, sound, color profile and rotation stay untouched (lossless stream copy, no re-encode)." />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Name="SelectStripFileButton" Content="Select file..." Click="OnSelectStripFileClick" />
			</StackPanel>
		</StackPanel>

		<StackPanel Spacing="4">
			<TextBlock Text="Camera microphone audio (.AAC)" Classes="infoLabel" Margin="0" />
			<TextBlock Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
			           Text="With an external mic connected, the camera saves its built-in microphones as a separate .AAC file, which Vegas Pro and Audacity can't open. Converts it without any quality loss (verified sample by sample), saved next to the original. WAV works everywhere; M4A keeps the original AAC data, 10x smaller." />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Name="ConvertAudioWavButton" Content="To WAV..." Click="OnConvertAudioWavClick" />
				<Button Name="ConvertAudioM4aButton" Content="To M4A..." Click="OnConvertAudioM4aClick" />
			</StackPanel>
		</StackPanel>

		<StackPanel Spacing="4">
			<TextBlock Text="Compare videos" Classes="infoLabel" Margin="0" />
			<TextBlock Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
			           Text="Pick up to 6 files to see their resolution, codec, color tags, bitrate and telemetry side by side." />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Compare..." Click="OnCompareVideosClick" />
			</StackPanel>
		</StackPanel>

		<StackPanel Spacing="4">
			<TextBlock Text="Data" Classes="infoLabel" Margin="0" />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Open data folder" Click="OnOpenDataFolderClick" />
				<Button Content="Clear cache" Click="OnClearCacheClick"
				        ToolTip.Tip="Deletes the cached file analysis (telemetry, video info) for every file, so the next 'Get Summary' recomputes everything from scratch instead of reusing a stored result." />
			</StackPanel>
		</StackPanel>

		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0" />
			<Button Grid.Column="1" Content="Close" Classes="accent" Click="OnCloseClick" />
		</Grid>
	</StackPanel>
</Window>
