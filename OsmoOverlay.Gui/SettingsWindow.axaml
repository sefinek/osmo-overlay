<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="OsmoOverlay.Gui.SettingsWindow"
        Width="820" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#121214"
        Title="Settings">

	<Window.Styles>
		<!-- No Margin on either: vertical rhythm comes entirely from the StackPanel.Spacing tiers
		     each panel below uses (20 between sections, 6 within a section, 4 between list items) -
		     mixing per-control margins into that would double up gaps and drift out of sync between
		     panels, which is what made General/Map/Route intro each look subtly different before. -->
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Opacity" Value="0.55" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Opacity" Value="0.4" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<!-- Same FontSize/Padding as MainWindow's CheckBox.overlayItem (this window can't reach that
		     Window.Styles-scoped class directly) - every CheckBox/RadioButton here uses it so the whole
		     dialog reads as one row height instead of the default FluentTheme size looking taller than
		     the app's own established checkbox-list convention. Deliberately no Height/MinHeight override
		     here - forcing an exact Height clips the indicator glyph's bottom edge (FluentTheme's
		     template needs more room than a tight guess gives it), so row tightness comes from the
		     StackPanel Spacing tiers alone, same as overlayItem does. -->
		<Style Selector="CheckBox, RadioButton">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="8,0,0,0" />
		</Style>
		<!-- Scoped to this window's own nav list (not every ListBox app-wide) - drops the boxed-in
		     card look App.axaml's generic ListBox style gives every other list, since this one reads
		     as a sidebar rail, not a bordered panel. -->
		<Style Selector="ListBox#CategoryList">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem">
			<Setter Property="Padding" Value="14,10" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>
	</Window.Styles>

	<Grid>
		<Grid ColumnDefinitions="180,*">
			<Border Grid.Column="0" Background="#1B1B1E" Padding="10">
				<ListBox Name="CategoryList" SelectedIndex="0" SelectionChanged="OnCategoryChanged">
					<ListBoxItem Content="General" />
					<ListBoxItem Content="Map" />
					<ListBoxItem Content="Route intro" />
				</ListBox>
			</Border>

			<Grid Grid.Column="1">
				<ScrollViewer Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="24,20" Spacing="20">
						<StackPanel Spacing="6">
							<TextBlock Text="Frame limit (optional)" Classes="infoLabel" />
							<NumericUpDown Name="FrameLimitBox" Minimum="0" Increment="60" FormatString="0"
							               PlaceholderText="No limit" HorizontalAlignment="Stretch" />
							<TextBlock Classes="hint"
							           Text="Limits how many frames get rendered on export - e.g. set 300 to render only the first few seconds instead of the whole file. Useful for quickly testing overlay changes without waiting for a full render. Leave empty to render the entire video." />
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="Watermark" Classes="infoLabel" />
							<CheckBox Name="ShowWatermarkCheck" Content="Show attribution watermark" />
							<TextBlock Classes="hint"
							           Text="Shows 'Made with OsmoOverlay' plus the project link at the bottom of the video for the first few seconds, fading out. On by default." />
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="GPS motion" Classes="infoLabel" />
							<CheckBox Name="SmoothGpsMotionCheck" Content="Smooth GPS-derived motion" />
							<TextBlock Classes="hint"
							           Text="The camera's GPS only reports a new fix a few times a second, so the Compass trail and Map widget normally hold position for several frames then jump. This interpolates between real fixes for a smoother pan/trail. Off by default; takes effect the next time a file/preview is opened." />
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Text="Preview quality" Classes="infoLabel" />
							<ComboBox Name="PreviewQualityCombo" HorizontalAlignment="Stretch" />
							<TextBlock Classes="hint"
							           Text="How sharp the live preview looks while scrubbing/playing - lower is faster (less to decode per frame), higher is sharper but slower. Never affects the exported video, which always renders at the source's full resolution regardless of this setting. Takes effect the next time a file/preview is opened." />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="MapPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
					<StackPanel Margin="24,20" Spacing="20">
						<StackPanel Spacing="6">
							<TextBlock Text="Map tile source" Classes="infoLabel" />
							<TextBlock Classes="hint"
							           Text="Shared by every map-based widget (the Map widget, the route-overview start card) - one provider/key for the whole preset instead of setting it up per widget." />
							<ComboBox Name="MapProviderCombo" HorizontalAlignment="Stretch" SelectionChanged="OnMapProviderChanged" />
							<TextBlock Name="MapCustomUrlLabel" Text="Custom tile URL template" Classes="infoLabel" IsVisible="False" />
							<TextBox Name="MapTileUrlBox" IsVisible="False"
							         PlaceholderText="https://tile.example.com/{z}/{x}/{y}.png"
							         LostFocus="OnMapTileUrlChanged" TextWrapping="Wrap" />
							<TextBlock Name="MapApiKeyLabel" Text="API key" Classes="infoLabel" IsVisible="False" />
							<TextBox Name="MapApiKeyBox" IsVisible="False" PlaceholderText="Paste your API key"
							         PasswordChar="•" LostFocus="OnMapApiKeyChanged" />
							<TextBlock Name="MapApiKeyHint" Classes="hint" Opacity="1" Foreground="#E5484D" IsVisible="False"
							           Text="Doesn't look like a CARTO key - expected format: xxx_xxxx_n_&lt;24 hex chars&gt;." />
						</StackPanel>

						<StackPanel Spacing="6">
							<CheckBox Name="MapShowAttributionCheck" Content="Show attribution on the video"
							          Click="OnMapShowAttributionChanged" />
							<TextBlock Classes="hint"
							           Text="Turning this off means you must credit the map source yourself elsewhere (e.g. in the video description)." />
						</StackPanel>

						<StackPanel Spacing="6">
							<TextBlock Name="MapAttributionLabel" Text="Attribution" Classes="infoLabel" />
							<TextBox Name="MapAttributionBox" PlaceholderText="© OpenStreetMap contributors" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="RouteIntroPanel" VerticalScrollBarVisibility="Auto" IsVisible="False">
					<StackPanel Margin="24,20" Spacing="20">
						<StackPanel Spacing="6">
							<TextBlock Text="Route overview start card" Classes="infoLabel" />
							<CheckBox Name="ShowRouteIntroCheck" Content="Show fullscreen route overview at the start"
							          Click="OnShowRouteIntroChanged" />
							<TextBlock Classes="hint"
							           Text="A fullscreen card shown for the first few seconds of the render: the whole route on a map plus the trip stats checked below. Needs a GPS fix and network access to fetch the overview map." />
						</StackPanel>

						<StackPanel Name="RouteIntroOptionsPanel" Spacing="20">
							<StackPanel Spacing="6">
								<TextBlock Name="RouteIntroDurationLabel" Text="Duration (seconds)" Classes="infoLabel" />
								<NumericUpDown Name="RouteIntroDurationBox" Minimum="1" Maximum="30" Increment="1"
								               FormatString="0" HorizontalAlignment="Stretch" />
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Name="RouteIntroStatsLabel" Text="Stats to show" Classes="infoLabel" />
								<StackPanel Spacing="2">
									<CheckBox Name="RouteIntroDistanceCheck" Content="Total distance" />
									<CheckBox Name="RouteIntroMaxSpeedCheck" Content="Max speed" />
									<CheckBox Name="RouteIntroAvgSpeedCheck" Content="Average speed" />
									<CheckBox Name="RouteIntroDateCheck" Content="Date" />
									<CheckBox Name="RouteIntroDurationCheck" Content="Recording duration" />
									<CheckBox Name="RouteIntroElevationGainCheck" Content="Elevation gain" />
									<CheckBox Name="RouteIntroCameraModelCheck" Content="Camera model" />
								</StackPanel>
							</StackPanel>

							<StackPanel Spacing="6">
								<TextBlock Text="Units" Classes="infoLabel" />
								<StackPanel Orientation="Horizontal" Spacing="16">
									<RadioButton Name="RouteIntroMetricRadio" Content="Metric" GroupName="RouteIntroUnits" />
									<RadioButton Name="RouteIntroImperialRadio" Content="Imperial" GroupName="RouteIntroUnits" />
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</Window>
