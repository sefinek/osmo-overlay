<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.KeyMomentsEditor">

	<UserControl.Resources>
		<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource SurfaceColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{StaticResource ControlColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{StaticResource ControlPressedColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource ControlBorderColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="{StaticResource ControlBorderHoverColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="{StaticResource ControlBorderHoverColor}" />
		<SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource SurfaceInsetColor}" />
		<SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{StaticResource ControlBorderColor}" />
		<SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
	</UserControl.Resources>

	<StackPanel Spacing="14">
		<StackPanel Spacing="6">
			<TextBlock Text="Mark the frame on screen" Classes="infoLabel" Margin="0" />
			<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnAddClick"
			        ToolTip.Tip="Adds a key moment at the frame on screen (B)">
				<StackPanel Orientation="Horizontal" Spacing="7">
					<local:IconView Data="{StaticResource IconFlag}" Width="13" Height="13" VerticalAlignment="Center" />
					<TextBlock Text="Add key moment (B)" VerticalAlignment="Center" />
				</StackPanel>
			</Button>
		</StackPanel>

		<StackPanel Spacing="6">
			<TextBlock Text="Jump to" Classes="infoLabel" Margin="0" />
			<StackPanel Name="PeakRows" Spacing="6" />
			<TextBlock Name="NoPeaksText" Classes="hint" IsVisible="False" Text="This recording has no telemetry to find a peak in." />
		</StackPanel>

		<StackPanel Name="MomentListPanel" Spacing="6" IsVisible="False">
			<TextBlock Text="Key moments" Classes="infoLabel" Margin="0" />
			<StackPanel Name="MomentRows" Spacing="6" />
		</StackPanel>

		<TextBlock Classes="hint"
		           Text="A key moment is a named point of the recording, drawn as a flag on the timeline - Up and Down jump from one to the next. They don't change the render. Each category lists its three highest peaks - jump to one, or save it as a key moment with the flag next to it. Moments are saved with the project." />
	</StackPanel>
</UserControl>
