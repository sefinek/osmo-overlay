<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.ElementPanelEditor">

	<StackPanel Spacing="8">
		<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.Common_Color}" Classes="infoLabel" Margin="0" />
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
					<Border Grid.Column="0" Name="ColorPreview" Width="20" Height="20"
					        CornerRadius="4" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
					<TextBox Grid.Column="1" Name="ColorBox" PlaceholderText="#000000" />
				</Grid>
			</StackPanel>
			<StackPanel Grid.Column="1" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.Common_Opacity}" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="OpacityBox" Minimum="0" Maximum="100" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
			</StackPanel>
		</Grid>
		<TextBlock Classes="hint" Text="{x:Static local:Strings.ElementPanel_0LeavesJustTheRing}" />
		<Button Name="ApplyToAllButton" Content="{x:Static local:Strings.ElementPanel_ApplyToAllPanels}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
		        ToolTip.Tip="{x:Static local:Strings.ElementPanel_GivesEveryWidgetWithA}" />
	</StackPanel>
</UserControl>
