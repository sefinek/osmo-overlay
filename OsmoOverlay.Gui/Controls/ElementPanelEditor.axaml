<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.ElementPanelEditor">

	<StackPanel Spacing="8">
		<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="Color" Classes="infoLabel" Margin="0" />
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
					<Border Grid.Column="0" Name="ColorPreview" Width="20" Height="20"
					        CornerRadius="4" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
					<TextBox Grid.Column="1" Name="ColorBox" PlaceholderText="#000000" />
				</Grid>
			</StackPanel>
			<StackPanel Grid.Column="1" Spacing="8">
				<TextBlock Text="Opacity (%)" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="OpacityBox" Minimum="0" Maximum="100" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
			</StackPanel>
		</Grid>
		<TextBlock Classes="hint" Text="0 leaves just the ring and what's inside it." />
		<Button Name="ApplyToAllButton" Content="Apply to all panels" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
		        ToolTip.Tip="Gives every widget with a panel this color and opacity" />
	</StackPanel>
</UserControl>
