<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.MarkerStyleEditor">

	<StackPanel Spacing="8">
		<TextBlock Text="Position marker" Classes="infoLabel" Margin="0" />
		<StackPanel Orientation="Horizontal" Spacing="12">
			<RadioButton Name="ArrowRadio" Content="Arrow" />
			<RadioButton Name="DotRadio" Content="Dot" />
		</StackPanel>
		<TextBlock Text="Size" Classes="infoLabel" Margin="0" />
		<NumericUpDown Name="ScaleBox" Minimum="0.3" Maximum="4" Increment="0.1" FormatString="0.0"
		               HorizontalAlignment="Stretch" />
		<TextBlock Text="Color" Classes="infoLabel" Margin="0" />
		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
			<Border Grid.Column="0" Name="SwatchBorder" Width="20" Height="20" CornerRadius="4"
			        BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
			<TextBox Grid.Column="1" Name="ColorBox" />
		</Grid>
	</StackPanel>
</UserControl>
