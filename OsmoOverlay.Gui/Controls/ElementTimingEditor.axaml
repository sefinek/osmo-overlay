<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.ElementTimingEditor">

	<StackPanel Spacing="8">
		<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="Appear at" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="AppearAtBox" Minimum="0" Increment="1" PlaceholderText="Start" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Spacing="8">
				<TextBlock Text="Disappear at" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="DisappearAtBox" Minimum="0" Increment="1" PlaceholderText="Never" HorizontalAlignment="Stretch" />
			</StackPanel>
		</Grid>
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="In animation" Classes="infoLabel" Margin="0" />
				<ComboBox Name="InAnimationCombo" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Name="InDurationPanel" Spacing="8">
				<TextBlock Text="Length (s)" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="InDurationBox" Width="136" Increment="0.1" FormatString="0.0" />
			</StackPanel>
		</Grid>
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="Out animation" Classes="infoLabel" Margin="0" />
				<ComboBox Name="OutAnimationCombo" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Name="OutDurationPanel" Spacing="8">
				<TextBlock Text="Length (s)" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="OutDurationBox" Width="136" Increment="0.1" FormatString="0.0" />
			</StackPanel>
		</Grid>
		<TextBlock Classes="infoLabel" Margin="0" FontSize="11" Opacity="0.4" TextWrapping="Wrap"
		           Text="Times are in the rendered video, after cuts. On the expanded timeline each widget is a clip on a layer - drag it there, frame-exact." />
	</StackPanel>
</UserControl>
