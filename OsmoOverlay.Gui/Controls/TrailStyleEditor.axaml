<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.TrailStyleEditor">

	<StackPanel Spacing="8">
		<CheckBox Name="VisibleCheck" Content="Show the route" />
		<StackPanel Name="OptionsPanel" Spacing="8">
			<TextBlock Text="Trail color" Classes="infoLabel" Margin="0" />
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<Border Grid.Column="0" Name="SwatchBorder" Width="20" Height="20" CornerRadius="4"
				        BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
				<TextBox Grid.Column="1" Name="ColorBox" />
			</Grid>
			<CheckBox Name="BySpeedCheck" Content="Color by speed" />
			<TextBlock Classes="infoLabel" Margin="0,-4,0,0" FontSize="12" Opacity="0.45" TextWrapping="Wrap"
			           Text="Trail color when slow, through yellow and orange to red at the recording's top speed." />
			<TextBlock Text="Line thickness" Classes="infoLabel" Margin="0" />
			<NumericUpDown Name="WidthBox" Minimum="1" Maximum="12" Increment="0.5" FormatString="0.0"
			               HorizontalAlignment="Stretch" />
		</StackPanel>
	</StackPanel>
</UserControl>
