<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.EsriKeyGuide">

	<StackPanel Width="480" Spacing="14">
		<TextBlock Text="{x:Static local:Strings.EsriKeyGuide_Title}" FontWeight="SemiBold" FontSize="16" />
		<StackPanel Name="Steps" Spacing="6" />
		<TextBlock Text="{x:Static local:Strings.EsriKeyGuide_Expiry}" Classes="hint" FontSize="13" TextWrapping="Wrap" />
		<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
			<Button Classes="accent" Content="{x:Static local:Strings.EsriKeyGuide_OpenArcGis}" Click="OnOpenArcGisClick" />
			<Button Content="{x:Static local:Strings.EsriKeyGuide_Guide}" Click="OnGuideClick" />
		</StackPanel>
	</StackPanel>
</UserControl>
