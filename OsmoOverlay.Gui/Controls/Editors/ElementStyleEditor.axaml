<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             xmlns:core="clr-namespace:OsmoOverlay.Core.Overlay;assembly=OsmoOverlay.Core"
             x:Class="OsmoOverlay.Gui.ElementStyleEditor">

	<StackPanel Spacing="8">
		<TextBlock Text="{x:Static local:Strings.ElementStyle_Font}" Classes="infoLabel" Margin="0" />
		<ComboBox Name="FontCombo" HorizontalAlignment="Stretch" />
		<TextBlock Text="{x:Static local:Strings.ElementStyle_TextSize}" Classes="infoLabel" Margin="0" />
		<NumericUpDown Name="ScaleBox" Minimum="0.4" Maximum="2.5" Increment="0.05" FormatString="0.00" HorizontalAlignment="Stretch" />
		<TextBlock Name="TextColorLabel" Text="{x:Static local:Strings.ElementStyle_TextColor}" Classes="infoLabel" Margin="0" />
		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
			<Border Grid.Column="0" Name="TextColorSwatch" Width="20" Height="20"
			        CornerRadius="4" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
			<TextBox Grid.Column="1" Name="TextColorBox" PlaceholderText="{x:Static core:OverlayRenderer.DefaultTextColorHex}" />
		</Grid>
		<StackPanel Name="AccentColorPanel" Spacing="8" IsVisible="False">
			<TextBlock Text="{x:Static local:Strings.ElementStyle_ValueColor}" Classes="infoLabel" Margin="0" />
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<Border Grid.Column="0" Name="AccentColorSwatch" Width="20" Height="20"
				        CornerRadius="4" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
				<TextBox Grid.Column="1" Name="AccentColorBox" PlaceholderText="{x:Static core:OverlayRenderer.DefaultAccentColorHex}" />
			</Grid>
		</StackPanel>
		<TextBlock Text="{x:Static local:Strings.ElementStyle_OutlineColor}" Classes="infoLabel" Margin="0" />
		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
			<Border Grid.Column="0" Name="OutlineColorSwatch" Width="20" Height="20"
			        CornerRadius="4" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1" />
			<TextBox Grid.Column="1" Name="OutlineColorBox" PlaceholderText="{x:Static core:OverlayRenderer.DefaultOutlineColorHex}" />
		</Grid>
		<TextBlock Text="{x:Static local:Strings.ElementStyle_OutlineWidth}" Classes="infoLabel" Margin="0" />
		<NumericUpDown Name="OutlineWidthBox" Minimum="0" Maximum="3" Increment="0.1" FormatString="0.0" HorizontalAlignment="Stretch" />
		<StackPanel Name="ReadoutPanel" Spacing="8" IsVisible="False">
			<StackPanel Name="DecimalsPanel" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementStyle_Decimals}" Classes="infoLabel" Margin="0" />
				<ComboBox Name="DecimalsCombo" HorizontalAlignment="Stretch" />
			</StackPanel>
			<CheckBox Name="ShowLabelCheck" Content="{x:Static local:Strings.ElementStyle_ShowLabel}" />
			<CheckBox Name="ShowUnitCheck" Content="{x:Static local:Strings.ElementStyle_ShowUnit}" />
			<CheckBox Name="UppercaseCheck" Content="{x:Static local:Strings.ElementStyle_UppercaseLabel}" />
		</StackPanel>
		<StackPanel Name="AlignPanel" Spacing="8" IsVisible="False">
			<TextBlock Text="{x:Static local:Strings.ElementStyle_Align}" Classes="infoLabel" Margin="0" />
			<StackPanel Orientation="Horizontal" Spacing="12">
				<RadioButton Name="AlignLeftButton" Content="{x:Static local:Strings.ElementStyle_AlignLeft}" />
				<RadioButton Name="AlignCenterButton" Content="{x:Static local:Strings.ElementStyle_AlignCenter}" />
				<RadioButton Name="AlignRightButton" Content="{x:Static local:Strings.ElementStyle_AlignRight}" />
			</StackPanel>
			<TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static local:Strings.ElementStyle_AlignHint}" />
		</StackPanel>
		<TextBlock Text="{x:Static local:Strings.ElementStyle_Opacity}" Classes="infoLabel" Margin="0" />
		<NumericUpDown Name="OpacityBox" Minimum="10" Maximum="100" Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
		<Button Name="ApplyToAllButton" Content="{x:Static local:Strings.ElementStyle_ApplyFontAndColorsTo}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
		        ToolTip.Tip="{x:Static local:Strings.ElementStyle_GivesEveryTextWidgetThis}" />
	</StackPanel>
</UserControl>
