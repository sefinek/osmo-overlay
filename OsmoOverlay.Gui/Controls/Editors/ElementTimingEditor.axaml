<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.ElementTimingEditor">

	<StackPanel Spacing="8">
		<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_AppearAt}" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="AppearAtBox" Minimum="0" Increment="1" PlaceholderText="{x:Static local:Strings.ElementTiming_Start}" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_DisappearAt}" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="DisappearAtBox" Minimum="0" Increment="1" PlaceholderText="{x:Static local:Strings.ElementTiming_Never}" HorizontalAlignment="Stretch" />
			</StackPanel>
		</Grid>
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_InAnimation}" Classes="infoLabel" Margin="0" />
				<ComboBox Name="InAnimationCombo" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Name="InDurationPanel" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_LengthS}" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="InDurationBox" Width="136" Increment="0.1" FormatString="0.0" />
			</StackPanel>
		</Grid>
		<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
			<StackPanel Grid.Column="0" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_OutAnimation}" Classes="infoLabel" Margin="0" />
				<ComboBox Name="OutAnimationCombo" HorizontalAlignment="Stretch" />
			</StackPanel>
			<StackPanel Grid.Column="1" Name="OutDurationPanel" Spacing="8">
				<TextBlock Text="{x:Static local:Strings.ElementTiming_LengthS}" Classes="infoLabel" Margin="0" />
				<NumericUpDown Name="OutDurationBox" Width="136" Increment="0.1" FormatString="0.0" />
			</StackPanel>
		</Grid>
		<TextBlock Classes="infoLabel" Margin="0" FontSize="11" Opacity="0.4" TextWrapping="Wrap"
		           Text="{x:Static local:Strings.ElementTiming_TimesAreInTheRendered}" />
	</StackPanel>
</UserControl>
