<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.HeadingOptionsEditor">

	<StackPanel Spacing="8">
		<CheckBox Name="StabilizeCheck" Content="{x:Static local:Strings.Heading_Stabilize}" />
		<TextBlock Classes="infoLabel checkHint" Text="{x:Static local:Strings.Heading_StabilizeHint}" />
		<CheckBox Name="DotCheck" Content="{x:Static local:Strings.Heading_DotWhenNotFacing}" />
		<TextBlock Name="DotHint" Classes="infoLabel checkHint" Text="{x:Static local:Strings.Heading_DotWhenNotFacingHint}" />
		<TextBlock Name="ToleranceLabel" Text="{x:Static local:Strings.Heading_FacingTolerance}" Classes="infoLabel" Margin="0" />
		<NumericUpDown Name="ToleranceBox" Increment="5" FormatString="0" HorizontalAlignment="Stretch" />
	</StackPanel>
</UserControl>
