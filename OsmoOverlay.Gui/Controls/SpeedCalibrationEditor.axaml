<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OsmoOverlay.Gui"
             x:Class="OsmoOverlay.Gui.SpeedCalibrationEditor">

	<StackPanel Spacing="12">
		<StackPanel Spacing="6">
			<TextBlock Text="{x:Static local:Strings.SpeedCalibration_SpeedCorrection}" Classes="infoLabel" />
			<NumericUpDown Name="CorrectionBox" Minimum="0" Increment="0.1" FormatString="0.0" HorizontalAlignment="Stretch" />
			<TextBlock Name="CorrectionText" Classes="hint" />
		</StackPanel>

		<Border Classes="card" Padding="14">
			<StackPanel Spacing="8">
				<TextBlock Text="{x:Static local:Strings.SpeedCalibration_WorkItOutFromYour}" FontWeight="SemiBold" />
				<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
					<StackPanel Grid.Column="0" Spacing="4">
						<TextBlock Text="{x:Static local:Strings.SpeedCalibration_RealSpeedSpeedometerLimiter}" Classes="infoLabel" />
						<NumericUpDown Name="RealSpeedBox" PlaceholderText="{x:Static local:Strings.SpeedCalibration_RealPlaceholder}" Minimum="1" Maximum="500" Increment="0.1" FormatString="0.##"
						               HorizontalAlignment="Stretch" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="4">
						<TextBlock Text="{x:Static local:Strings.SpeedCalibration_MeasuredByTheGpsNo}" Classes="infoLabel" />
						<NumericUpDown Name="ShownSpeedBox" PlaceholderText="{x:Static local:Strings.SpeedCalibration_GpsPlaceholder}" Minimum="1" Maximum="500" Increment="0.1" FormatString="0.##"
						               HorizontalAlignment="Stretch" />
					</StackPanel>
				</Grid>
				<Button Name="UseRecordingButton" HorizontalAlignment="Left" IsVisible="False" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBlock Grid.Column="0" Name="ResultText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Button Grid.Column="1" Name="ApplyButton" Classes="accent" IsVisible="False" VerticalAlignment="Center" />
				</Grid>
				<TextBlock Classes="hint"
				           Text="{x:Static local:Strings.SpeedCalibration_CompareTheSpeedYouRide}" />
			</StackPanel>
		</Border>
	</StackPanel>
</UserControl>
