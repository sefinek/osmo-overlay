<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.SpeedCalibrationEditor">

	<StackPanel Spacing="12">
		<StackPanel Spacing="6">
			<TextBlock Text="Speed correction (%)" Classes="infoLabel" />
			<NumericUpDown Name="CorrectionBox" Minimum="0" Increment="0.1" FormatString="0.0" HorizontalAlignment="Stretch" />
			<TextBlock Name="CorrectionText" Classes="hint" />
		</StackPanel>

		<Border Classes="card" Padding="14">
			<StackPanel Spacing="8">
				<TextBlock Text="Work it out from a known top speed" FontWeight="SemiBold" />
				<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
					<StackPanel Grid.Column="0" Spacing="4">
						<TextBlock Text="Real top speed" Classes="infoLabel" />
						<NumericUpDown Name="RealSpeedBox" PlaceholderText="e.g. 25" Minimum="1" Maximum="500" Increment="0.1" FormatString="0.##"
						               HorizontalAlignment="Stretch" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="4">
						<TextBlock Text="Measured top speed (no correction)" Classes="infoLabel" />
						<NumericUpDown Name="ShownSpeedBox" PlaceholderText="e.g. 22" Minimum="1" Maximum="500" Increment="0.1" FormatString="0.##"
						               HorizontalAlignment="Stretch" />
					</StackPanel>
				</Grid>
				<Button Name="UseRecordingButton" HorizontalAlignment="Left" IsVisible="False" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBlock Grid.Column="0" Name="ResultText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Button Grid.Column="1" Name="ApplyButton" Classes="accent" IsVisible="False" VerticalAlignment="Center" />
				</Grid>
				<TextBlock Classes="hint"
				           Text="Same unit for both. The measured top speed is the GPS reading before any correction - with a recording loaded it's filled in exactly; otherwise set the correction to 0 and read the widget's top speed (rounded to whole numbers). A speedometer usually reads a little high; a speed limiter or a GPS app is a better reference for the real speed." />
			</StackPanel>
		</Border>
	</StackPanel>
</UserControl>
