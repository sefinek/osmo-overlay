<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="640"
        x:Class="OsmoOverlay.Gui.WidgetSettingsWindow"
        Width="420" MinWidth="340" MinHeight="240" MaxHeight="820"
        SizeToContent="Height"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#121214"
        Title="Widget settings">

	<!-- Duplicated (not shared with MainWindow's own Window.Styles) because a Style's classes are only
	     visible to the window's own logical-tree descendants - the settings panels adopted here via
	     ShowPanel are reparented out of MainWindow's tree, so they need this window's own copy to stay
	     styled, the same reason SettingsWindow/ToolsWindow/CompareVideosWindow already carry their own
	     copy of TextBlock.infoLabel instead of reaching MainWindow's. -->
	<Window.Styles>
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="Margin" Value="0,5" />
		</Style>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="LetterSpacing" Value="0.6" />
			<Setter Property="Margin" Value="0,8,0,2" />
		</Style>
		<Style Selector="TextBlock.eyebrowLabel">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="LetterSpacing" Value="1" />
		</Style>
		<Style Selector="StackPanel.settingsFlyout">
			<Setter Property="Spacing" Value="8" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Border.flyoutDivider">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="#26FFFFFF" />
			<Setter Property="Margin" Value="0,10,0,2" />
		</Style>
		<Style Selector="Border.settingsGroup">
			<Setter Property="Background" Value="#18181B" />
			<Setter Property="BorderBrush" Value="#22FFFFFF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,10" />
		</Style>
		<Style Selector="TextBlock.settingsGroupTitle">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="LetterSpacing" Value="0.6" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>
		<Style Selector="Border.calloutInfo">
			<Setter Property="Background" Value="#15212E" />
			<Setter Property="BorderBrush" Value="#2A4258" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
		<Style Selector="TextBlock.calloutInfoText">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="15" />
		</Style>
		<Style Selector="Button.toolbar">
			<Setter Property="Background" Value="#232327" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Padding" Value="0,7" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2E2E33" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,*" Margin="20,18,20,18" RowSpacing="10">
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
			<StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
				<TextBlock Text="WIDGET SETTINGS" Classes="eyebrowLabel" />
				<TextBlock Name="TitleText" FontSize="19" FontWeight="SemiBold" Text="Widget settings" />
			</StackPanel>
			<Button Grid.Column="1" Name="ResetButton" Classes="toolbar" Content="Reset to default"
			        HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center"
			        Padding="12,7" FontSize="12" Click="OnResetButtonClick" />
		</Grid>
		<Border Grid.Row="1" Height="1" Background="#26FFFFFF" />
		<ScrollViewer Grid.Row="2" Name="PanelScroll" HorizontalScrollBarVisibility="Disabled">
			<ContentControl Name="PanelHost" HorizontalContentAlignment="Stretch" Margin="0,0,0,4" />
		</ScrollViewer>
	</Grid>
</Window>
