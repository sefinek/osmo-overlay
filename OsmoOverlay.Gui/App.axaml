<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OsmoOverlay.Gui.App"
             RequestedThemeVariant="Dark">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://OsmoOverlay/Icons.axaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Palette - the only place a UI color is defined; XAML uses the *Brush keys, C# goes through Palette. -->
			<Color x:Key="WindowBackgroundColor">#111113</Color>
			<Color x:Key="SurfaceColor">#19191C</Color>
			<Color x:Key="SurfaceInsetColor">#151518</Color>
			<Color x:Key="SurfaceSunkenColor">#0C0C0E</Color>
			<Color x:Key="ControlColor">#222226</Color>
			<Color x:Key="ControlHoverColor">#2C2C31</Color>
			<Color x:Key="ControlPressedColor">#1C1C20</Color>
			<Color x:Key="ControlBorderColor">#2E2E34</Color>
			<Color x:Key="ControlBorderHoverColor">#3C3C43</Color>
			<Color x:Key="CardBorderColor">#12FFFFFF</Color>
			<Color x:Key="StrokeColor">#24FFFFFF</Color>
			<Color x:Key="StrokeStrongColor">#40FFFFFF</Color>
			<Color x:Key="SubtleFillColor">#0AFFFFFF</Color>
			<Color x:Key="TextPrimaryColor">#EDEDEF</Color>
			<Color x:Key="TextSecondaryColor">#C7C7CC</Color>
			<Color x:Key="TextMutedColor">#85858D</Color>
			<Color x:Key="OnVideoColor">#CC18181B</Color>
			<Color x:Key="OnVideoBorderColor">#60FFFFFF</Color>
			<Color x:Key="ScrimColor">#A6000000</Color>

			<Color x:Key="AccentColor">#3E9EFF</Color>
			<Color x:Key="AccentHoverColor">#5CACFF</Color>
			<Color x:Key="AccentPressedColor">#2E7ECC</Color>
			<Color x:Key="AccentSubtleColor">#172537</Color>
			<Color x:Key="AccentCalloutBorderColor">#26405C</Color>
			<Color x:Key="SuccessColor">#3EBE6E</Color>
			<Color x:Key="SuccessHoverColor">#5CD98A</Color>
			<Color x:Key="SuccessPressedColor">#2E9256</Color>
			<Color x:Key="SuccessSubtleColor">#15291D</Color>
			<Color x:Key="WarningColor">#E5A83E</Color>
			<Color x:Key="WarningHoverColor">#FFC15C</Color>
			<Color x:Key="WarningPressedColor">#C98A2E</Color>
			<Color x:Key="DangerColor">#E5484D</Color>
			<Color x:Key="DangerHoverColor">#FF6369</Color>
			<Color x:Key="DangerPressedColor">#C93E42</Color>

			<SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
			<SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
			<SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
			<SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
			<SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
			<SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
			<SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
			<SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
			<SolidColorBrush x:Key="ControlBorderHoverBrush" Color="{StaticResource ControlBorderHoverColor}" />
			<SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
			<SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
			<SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
			<SolidColorBrush x:Key="SubtleFillBrush" Color="{StaticResource SubtleFillColor}" />
			<SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
			<SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
			<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
			<SolidColorBrush x:Key="OnVideoBrush" Color="{StaticResource OnVideoColor}" />
			<SolidColorBrush x:Key="OnVideoBorderBrush" Color="{StaticResource OnVideoBorderColor}" />
			<SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
			<SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
			<SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
			<SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
			<SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
			<SolidColorBrush x:Key="AccentCalloutBorderBrush" Color="{StaticResource AccentCalloutBorderColor}" />
			<SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
			<SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}" />
			<SolidColorBrush x:Key="SuccessPressedBrush" Color="{StaticResource SuccessPressedColor}" />
			<SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
			<SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
			<SolidColorBrush x:Key="WarningHoverBrush" Color="{StaticResource WarningHoverColor}" />
			<SolidColorBrush x:Key="WarningPressedBrush" Color="{StaticResource WarningPressedColor}" />
			<SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
			<SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
			<SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />

			<!-- Fluent derives its own accent shades (checkboxes, sliders, toggles) from these. -->
			<Color x:Key="SystemAccentColor">#3E9EFF</Color>
			<Color x:Key="SystemAccentColorDark1">#2E7ECC</Color>
			<Color x:Key="SystemAccentColorDark2">#1F5E99</Color>
			<Color x:Key="SystemAccentColorDark3">#123D66</Color>
			<Color x:Key="SystemAccentColorLight1">#5CACFF</Color>
			<Color x:Key="SystemAccentColorLight2">#7DBEFF</Color>
			<Color x:Key="SystemAccentColorLight3">#9ECEFF</Color>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />

		<Style Selector="Button, RepeatButton, ToggleButton, CheckBox, RadioButton, ComboBoxItem, ListBoxItem">
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button:disabled, ToggleButton:disabled, CheckBox:disabled, RadioButton:disabled, ComboBoxItem:disabled, ListBoxItem:disabled">
			<Setter Property="Cursor" Value="Arrow" />
		</Style>

		<Style Selector="Button">
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Button:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}" />
		</Style>
		<Style Selector="Button:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
		</Style>
		<Style Selector="Button:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
		</Style>

		<Style Selector="Button.accent, Button.danger, Button.success, Button.warning">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.accent">
			<Setter Property="Background" Value="{StaticResource AccentBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.accent:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
		</Style>
		<Style Selector="Button.accent:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
		</Style>
		<Style Selector="Button.danger">
			<Setter Property="Background" Value="{StaticResource DangerBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.danger:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
		</Style>
		<Style Selector="Button.danger:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource DangerPressedBrush}" />
		</Style>
		<Style Selector="Button.success">
			<Setter Property="Background" Value="{StaticResource SuccessBrush}" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.success:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SuccessHoverBrush}" />
		</Style>
		<Style Selector="Button.success:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SuccessPressedBrush}" />
		</Style>
		<Style Selector="Button.warning">
			<Setter Property="Background" Value="{StaticResource WarningBrush}" />
			<Setter Property="Foreground" Value="Black" />
		</Style>
		<Style Selector="Button.warning:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource WarningHoverBrush}" />
		</Style>
		<Style Selector="Button.warning:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource WarningPressedBrush}" />
		</Style>

		<Style Selector="TextBox, ComboBox, NumericUpDown, ListBox">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}" />
		</Style>
		<Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="ComboBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>

		<Style Selector="ToolTip">
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="MaxWidth" Value="380" />
		</Style>

		<!-- Scrollbars beside the content, not over it: Fluent's auto-hiding bars overlay the content and, expanded
		     on hover, covered the right edge of the cards. Without auto-hide the theme keeps the content presenter
		     in its own cell and the bar in the Auto column next to it (collapsed when there's nothing to scroll). -->
		<Style Selector="ScrollViewer">
			<Setter Property="AllowAutoHide" Value="False" />
		</Style>
		<Style Selector="ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
			<Setter Property="Margin" Value="4,0,0,0" />
		</Style>
		<Style Selector="ScrollViewer /template/ ScrollBar#PART_HorizontalScrollBar">
			<Setter Property="Margin" Value="0,4,0,0" />
		</Style>

		<!-- A slim bar: just the thumb on a transparent track, no arrow buttons. -->
		<Style Selector="ScrollBar">
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="MinHeight" Value="0" />
		</Style>
		<Style Selector="ScrollBar:vertical">
			<Setter Property="Width" Value="6" />
		</Style>
		<Style Selector="ScrollBar:horizontal">
			<Setter Property="Height" Value="6" />
		</Style>
		<Style Selector="ScrollBar /template/ Grid#Root">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="ScrollBar /template/ Rectangle#TrackRect">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
			<Setter Property="IsVisible" Value="False" />
		</Style>

		<Style Selector="ScrollBar /template/ Thumb">
			<Setter Property="Background" Value="{StaticResource ControlBorderHoverBrush}" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="RenderTransform" Value="none" />
		</Style>
		<Style Selector="ScrollBar /template/ Thumb:pointerover">
			<Setter Property="Background" Value="{StaticResource StrokeStrongBrush}" />
		</Style>

		<Style Selector="TextBox#LogBox:focus /template/ Border#PART_BorderElement">
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="TextBox#LogBox:focus-within /template/ Border#PART_BorderElement">
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<!-- Shared building blocks for every window; a window only overrides layout (margins, padding) locally. -->
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="12" />
		</Style>
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Opacity" Value="0.55" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Opacity" Value="0.45" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Opacity" Value="0.45" />
		</Style>
	</Application.Styles>
</Application>
