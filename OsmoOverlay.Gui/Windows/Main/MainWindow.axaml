														<local:ElementPanelEditor Name="ProfileChartPanelFill" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="ProfileChartShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="ProfileChartTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>
									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="TripStatListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.TripStat}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Main_TripStatistic}" />
										</Border>
										<Border Name="TripStatSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_StatisticHeader}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_Statistic}" Classes="infoLabel" Margin="0" />
														<ComboBox Name="TripStatCombo" HorizontalAlignment="Stretch"
														          SelectionChanged="OnTripStatKindChanged" />
														<TextBlock Classes="infoLabel" Margin="0,0,0,4" FontSize="11" Opacity="0.4" TextWrapping="Wrap"
														           Text="{x:Static local:Strings.Main_CountedUpToTheMoment}" />
														<TextBlock Text="{x:Static local:Strings.Main_Label}" Classes="infoLabel" Margin="0" />
														<TextBox Name="TripStatLabelBox" LostFocus="OnTripStatLabelChanged" />
														<TextBlock Text="{x:Static local:Strings.Common_Units}" Classes="infoLabel" Margin="0" />
														<StackPanel Orientation="Horizontal" Spacing="12">
															<RadioButton Name="TripStatMetricRadio" Content="{x:Static local:Strings.Common_Metric}"
															             GroupName="TripStatUnits" Click="OnTripStatUnitsChanged" />
															<RadioButton Name="TripStatImperialRadio" Content="{x:Static local:Strings.Common_Imperial}"
															             GroupName="TripStatUnits" Click="OnTripStatUnitsChanged" />
														</StackPanel>
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Style}" Classes="settingsGroupTitle" />
														<local:ElementStyleEditor Name="TripStatStyle" HasAccentColor="True" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="TripStatShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="TripStatTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="ElevationListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.Elevation}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Main_Elevation}" />
										</Border>
										<Border Name="ElevationSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Display}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_Label}" Classes="infoLabel" Margin="0" />
														<TextBox Name="ElevationLabelBox" PlaceholderText="{x:Static local:Strings.Main_Elevation}"
														         LostFocus="OnElevationLabelChanged" />
														<TextBlock Text="{x:Static local:Strings.Common_Units}" Classes="infoLabel" Margin="0" />
														<StackPanel Orientation="Horizontal" Spacing="12">
															<RadioButton Name="ElevationMetricRadio" Content="{x:Static local:Strings.Common_Metric}"
															             GroupName="ElevationUnits" Click="OnElevationUnitsChanged" />
															<RadioButton Name="ElevationImperialRadio" Content="{x:Static local:Strings.Common_Imperial}"
															             GroupName="ElevationUnits" Click="OnElevationUnitsChanged" />
														</StackPanel>
														<TextBlock Text="{x:Static local:Strings.Main_Shows}" Classes="infoLabel" Margin="0" />
														<StackPanel Orientation="Horizontal" Spacing="12">
															<RadioButton Name="ElevationFromStartRadio" Content="{x:Static local:Strings.Main_ChangeFromStart}"
															             GroupName="ElevationReference" Click="OnElevationReferenceChanged"
															             ToolTip.Tip="{x:Static local:Strings.Main_HowMuchHigherOrLower}" />
															<RadioButton Name="ElevationSeaLevelRadio" Content="{x:Static local:Strings.Main_AboveSeaLevel}"
															             GroupName="ElevationReference" Click="OnElevationReferenceChanged"
															             ToolTip.Tip="{x:Static local:Strings.Main_TheAltitudeTheCameraS}" />
														</StackPanel>
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Style}" Classes="settingsGroupTitle" />
														<local:ElementStyleEditor Name="ElevationStyle" HasAccentColor="True" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="ElevationShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="ElevationTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="GradientListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.Gradient}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Main_Gradient}" />
										</Border>
										<Border Name="GradientSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_LabelHeader}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_Label}" Classes="infoLabel" Margin="0" />
														<TextBox Name="GradientLabelBox" PlaceholderText="{x:Static local:Strings.Main_Gradient}"
														         LostFocus="OnGradientLabelChanged" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Style}" Classes="settingsGroupTitle" />
														<local:ElementStyleEditor Name="GradientStyle" HasAccentColor="True" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="GradientShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="GradientTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="DistanceListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.Distance}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Common_TotalDistance}" />
										</Border>
										<Border Name="DistanceSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Display}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_Label}" Classes="infoLabel" Margin="0" />
														<TextBox Name="DistanceLabelBox" PlaceholderText="{x:Static local:Strings.Common_TotalDistance}"
														         LostFocus="OnDistanceLabelChanged" />
														<TextBlock Text="{x:Static local:Strings.Common_Units}" Classes="infoLabel" Margin="0" />
														<StackPanel Orientation="Horizontal" Spacing="12">
															<RadioButton Name="DistanceMetricRadio" Content="{x:Static local:Strings.Common_Metric}"
															             GroupName="DistanceUnits" Click="OnDistanceUnitsChanged" />
															<RadioButton Name="DistanceImperialRadio" Content="{x:Static local:Strings.Common_Imperial}"
															             GroupName="DistanceUnits" Click="OnDistanceUnitsChanged" />
														</StackPanel>
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Style}" Classes="settingsGroupTitle" />
														<local:ElementStyleEditor Name="DistanceStyle" HasAccentColor="True" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="DistanceShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="DistanceTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="TextListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.Text}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Main_Text}" />
										</Border>
										<Border Name="TextSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Content}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_Text}" Classes="infoLabel" Margin="0" />
														<TextBox Name="TextContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
														         TextChanged="OnTextContentTyped" LostFocus="OnTextContentChanged" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Style}" Classes="settingsGroupTitle" />
														<local:ElementStyleEditor Name="TextStyle" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="TextShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="TextTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Border Grid.Column="0" Name="ImageListItem" Classes="overlayListItem"
										        Tag="{x:Static core:OverlayElementType.Image}"
										        PointerPressed="OnWidgetItemPointerPressed" PointerMoved="OnWidgetItemPointerMoved"
										        PointerReleased="OnWidgetItemPointerEnded" PointerCaptureLost="OnWidgetItemPointerEnded">
											<TextBlock Classes="overlayListItemText" Text="{x:Static local:Strings.Main_ImageLogo}" />
										</Border>
										<Border Name="ImageSettingsPanel" Grid.Column="1" IsVisible="False">
											<StackPanel Classes="settingsFlyout" Spacing="12">
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Image}" Classes="settingsGroupTitle" />
														<TextBlock Text="{x:Static local:Strings.Main_File}" Classes="infoLabel" Margin="0" />
														<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
															<TextBox Grid.Column="0" Name="ImagePathBox" IsReadOnly="True" PlaceholderText="{x:Static local:Strings.Main_NoImageChosen}" />
															<Button Grid.Column="1" Classes="toolbar" Content="{x:Static local:Strings.Main_Choose}" Padding="14,0"
															        VerticalAlignment="Stretch" VerticalContentAlignment="Center" Click="OnImageBrowseClick" />
														</Grid>
														<TextBlock Name="ImageUnreadableHint" Classes="infoLabel" Margin="0" FontSize="12"
														           Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" IsVisible="False"
														           Text="{x:Static local:Strings.Main_CanTReadThisFile}" />
														<TextBlock Classes="infoLabel" Margin="0,0,0,4" FontSize="11" Opacity="0.4" TextWrapping="Wrap"
														           Text="{x:Static local:Strings.Main_DrawnAtItsOwnPixel}" />
														<TextBlock Text="{x:Static local:Strings.Common_Opacity}" Classes="infoLabel" Margin="0" />
														<NumericUpDown Name="ImageOpacityBox" Minimum="0" Maximum="100" Increment="5"
														               FormatString="0" HorizontalAlignment="Stretch"
														               ValueChanged="OnImageOpacityChanged" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Shadow}" Classes="settingsGroupTitle" />
														<local:ElementShadowEditor Name="ImageShadow" />
													</StackPanel>
												</Border>
												<Border Classes="settingsGroup">
													<StackPanel Spacing="8">
														<TextBlock Text="{x:Static local:Strings.Main_Timing}" Classes="settingsGroupTitle" />
														<local:ElementTimingEditor Name="ImageTiming" />
													</StackPanel>
												</Border>
											</StackPanel>
										</Border>
									</Grid>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>

		<Border Grid.Row="1" Classes="card" Name="TimelineCard" IsVisible="False">
			<Grid Name="TimelineTracksGrid" ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
				<StackPanel Grid.Row="0" Grid.Column="0" Background="{StaticResource ControlBrush}">
					<Border Height="{x:Static local:PreviewTimeline.RulerHeight}">
						<StackPanel Orientation="Horizontal" Margin="10,0,0,0" Spacing="8" VerticalAlignment="Center">
							<TextBlock Text="{x:Static local:Strings.Main_Layers}" Classes="sectionLabel" Margin="0" VerticalAlignment="Center" />
							<Button Name="NewLayerButton" Classes="iconButton" Padding="6,0" MinWidth="0" MinHeight="0" Height="20"
							        VerticalAlignment="Center"
							        ToolTip.Tip="{x:Static local:Strings.Main_NewLayerAnEmptyOne}" Click="OnNewLayerClick">
								<local:IconView Data="{StaticResource IconPlus}" Width="11" Height="11" />
							</Button>
						</StackPanel>
					</Border>
					<Border Height="{x:Static local:PreviewTimeline.TrackGap}" />
					<Border Height="{x:Static local:PreviewTimeline.VideoTrackHeight}">
						<TextBlock Classes="timelineTrackName" Text="{x:Static local:Strings.Main_Video}" />
					</Border>
					<Border Height="{x:Static local:PreviewTimeline.TrackGap}" />
					<Border Height="{x:Static local:PreviewTimeline.AudioTrackHeight}">
						<TextBlock Classes="timelineTrackName" Text="{x:Static local:Strings.Main_Audio}" />
					</Border>
				</StackPanel>
				<Border Grid.Row="0" Grid.Column="1" Name="ExpandedTimelineFrame" CornerRadius="4" ClipToBounds="True">
					<local:PreviewTimeline Name="ExpandedTimeline" Expanded="True" Minimum="0" Maximum="1" IsEnabled="False"
					                       ValueChanged="OnExpandedTimelineValueChanged" />
				</Border>
				<ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="LayerScroll"
				              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<local:LayerTimeline Name="LayerTracks" />
				</ScrollViewer>
				<ScrollBar Grid.Row="2" Grid.Column="1" Name="TimelineScrollBar" Orientation="Horizontal" AllowAutoHide="False"
				           IsVisible="False" Scroll="OnTimelineScroll" />
			</Grid>
		</Border>

		<Border Grid.Row="1" Classes="card" Name="LogCard">
			<Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="10">
				<ScrollViewer Name="LogScroll">
					<SelectableTextBlock Name="LogBox" TextWrapping="Wrap"
					                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
				</ScrollViewer>
			</Border>
		</Border>
		<Border Name="PreviewBenchmarkStatus" Grid.Row="1" IsVisible="False" Classes="card"
		        HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="470" Padding="16">
			<StackPanel Spacing="8">
				<TextBlock Text="{x:Static local:Strings.PreviewBenchmark_Title}" FontWeight="SemiBold" />
				<TextBlock Name="PreviewBenchmarkProgress" TextWrapping="Wrap" />
				<Button Content="{x:Static local:Strings.Benchmark_Stop}" HorizontalAlignment="Left" Click="OnCancelPreviewBenchmarkClick" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
