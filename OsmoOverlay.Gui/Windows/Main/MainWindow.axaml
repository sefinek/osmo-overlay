<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:OsmoOverlay.Core.Overlay;assembly=OsmoOverlay.Core"
        xmlns:local="using:OsmoOverlay.Gui"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="OsmoOverlay.Gui.MainWindow"
        Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="{x:Static local:AppAssets.Icon}"
        Title="OsmoOverlay">

	<Window.Styles>
		<Style Selector="StackPanel.cardTitle">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Spacing" Value="8" />
			<Setter Property="Margin" Value="0,0,0,3" />
		</Style>
		<Style Selector="TextBlock.cardTitleText">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="LetterSpacing" Value="1" />
		</Style>
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Margin" Value="0,5" />
		</Style>
		<Style Selector="TextBlock.infoValue">
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Margin" Value="0,5" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="StackPanel.previewStatus">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Spacing" Value="6" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="StackPanel.previewStatus > local|IconView">
			<Setter Property="Width" Value="12" />
			<Setter Property="Height" Value="12" />
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="StackPanel.previewStatus > TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontFeatures" Value="+tnum" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="10,2" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.timelineTrackName">
			<Setter Property="Margin" Value="10,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
		</Style>
		<Style Selector="Button.toolbar">
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="Padding" Value="0,7" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>
		<Style Selector="Button.toolbar.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="ListBox#InputFilesList">
			<Setter Property="Padding" Value="3" />
		</Style>
		<Style Selector="ListBox#InputFilesList ListBoxItem">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Height" Value="32" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
		<Style Selector="ListBox#InputFilesList ListBoxItem:pointerover /template/ ContentPresenter, ListBox#InputFilesList ListBoxItem:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
		</Style>
		<Style Selector="ListBox#InputFilesList ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="ListBox#InputFilesList ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>
		<Style Selector="ListBox#InputFilesList ListBoxItem:selected:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="local|IconView.checkIcon">
			<Setter Property="Width" Value="13" />
			<Setter Property="Height" Value="13" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.transport">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.transport.active">
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
		</Style>
		<Style Selector="Button.transport.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="Button.iconButton">
			<Setter Property="Padding" Value="9,0" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="Margin" Value="0,8,0,2" />
		</Style>
		<Style Selector="TextBlock.flyoutSectionLabel">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Opacity" Value="0.8" />
			<Setter Property="Margin" Value="0,8,0,2" />
		</Style>
		<Style Selector="Button.previewToolButton">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="Padding" Value="7" />
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.previewToolButton.comboLike">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
			<Setter Property="Opacity" Value="1" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.previewToolButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>
		<Style Selector="Button.previewToolButton.active">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
		</Style>
		<Style Selector="Button.previewToolButton.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="Slider.compact">
			<Style.Resources>
				<x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
				<x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
				<CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
				<GridLength x:Key="SliderPreContentMargin">*</GridLength>
				<GridLength x:Key="SliderPostContentMargin">*</GridLength>
				<x:Double x:Key="SliderHorizontalHeight">28</x:Double>
			</Style.Resources>
		</Style>
		<Style Selector="StackPanel.settingsFlyout">
			<Setter Property="Spacing" Value="8" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Border.flyoutDivider">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource StrokeBrush}" />
			<Setter Property="Margin" Value="0,10,0,2" />
		</Style>
		<Style Selector="Border.settingsGroup">
			<Setter Property="Background" Value="{StaticResource SurfaceInsetBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,10" />
		</Style>
		<Style Selector="TextBlock.settingsGroupTitle">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="LetterSpacing" Value="0.6" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>
		<Style Selector="Border.calloutInfo">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentCalloutBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
		<Style Selector="TextBlock.calloutInfoText">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Opacity" Value="0.8" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="18" />
		</Style>
		<Style Selector="Border.fallbackWarning">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Border.fallbackWarning > local|IconView">
			<Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
			<Setter Property="Width" Value="13" />
			<Setter Property="Height" Value="13" />
		</Style>
		<Style Selector="Border.overlayListItem">
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Border.overlayListItem:pointerover">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>
		<Style Selector="Border.overlayListItem.active">
			<Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
		</Style>
		<Style Selector="Border.overlayListItem:disabled">
			<Setter Property="Opacity" Value="0.35" />
			<Setter Property="Cursor" Value="Arrow" />
		</Style>
		<Style Selector="TextBlock.overlayListItemText">
			<Setter Property="FontSize" Value="13" />
		</Style>
		<Style Selector="Border.addedWidgetRow">
			<Setter Property="Background" Value="{StaticResource ControlBrush}" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Border.addedWidgetRow:pointerover">
			<Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
		</Style>
		<Style Selector="Border.addedWidgetRow.selected">
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="Button.addedWidgetAction">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.addedWidgetAction:pointerover /template/ ContentPresenter, Button.addedWidgetAction:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
		</Style>
		<Style Selector="Button.addedWidgetAction:pointerover">
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="Button.addedWidgetAction.remove:pointerover">
			<Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
		</Style>
		<Style Selector="Button.widgetHoverButton">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button.widgetGearButton">
			<Setter Property="Background" Value="{StaticResource OnVideoBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource OnVideoBorderBrush}" />
		</Style>
		<Style Selector="Button.widgetGearButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource ControlBorderHoverBrush}" />
		</Style>
		<Style Selector="Button.removeWidgetButton">
			<Setter Property="Background" Value="{StaticResource OnVideoBrush}" />
			<Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
		</Style>
		<Style Selector="Button.removeWidgetButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource DangerBrush}" />
		</Style>
		<Style Selector="Border.selectionHighlight">
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="Rectangle.hoverOutline">
			<Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
			<Setter Property="StrokeThickness" Value="1.5" />
			<Setter Property="StrokeDashArray" Value="4,3" />
			<Setter Property="RadiusX" Value="4" />
			<Setter Property="RadiusY" Value="4" />
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Rectangle.hoverOutline.shown">
			<Setter Property="Opacity" Value="1" />
			<Style.Animations>
				<Animation Duration="0:0:0.7" IterationCount="Infinite">
					<KeyFrame Cue="0%">
						<Setter Property="StrokeDashOffset" Value="0" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="StrokeDashOffset" Value="-7" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		<Style Selector="Border.hoverLabel">
			<Setter Property="Background" Value="{StaticResource OnVideoBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Padding" Value="6,1" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.hoverLabel.shown">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Border.hoverLabel TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style Selector="Ellipse.resizeHandle">
			<Setter Property="Width" Value="14" />
			<Setter Property="Height" Value="14" />
			<Setter Property="Fill" Value="{StaticResource AccentBrush}" />
			<Setter Property="Stroke" Value="White" />
			<Setter Property="StrokeThickness" Value="2" />
			<Setter Property="Cursor" Value="BottomRightCorner" />
		</Style>
		<Style Selector="Line.previewGuide">
			<Setter Property="Stroke" Value="{StaticResource StrokeStrongBrush}" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="StrokeDashArray" Value="4,4" />
		</Style>
		<Style Selector="Rectangle.previewGuide">
			<Setter Property="Stroke" Value="{StaticResource StrokeStrongBrush}" />
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="StrokeDashArray" Value="4,4" />
			<Setter Property="Fill" Value="Transparent" />
		</Style>
	</Window.Styles>

	<Grid Name="RootGrid" Margin="14" RowDefinitions="*,230" RowSpacing="10">

		<Grid Grid.Row="0" ColumnDefinitions="550,*,260" ColumnSpacing="10">

			<Grid Grid.Column="0">
				<ScrollViewer Name="SourceColumnScroll" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Spacing="10">
						<Border Classes="card">
							<StackPanel Spacing="8">
								<StackPanel Classes="cardTitle">
									<TextBlock Classes="cardTitleText" Text="{x:Static local:Strings.Main_Source}" />
								</StackPanel>

								<StackPanel Name="InputPanel" Spacing="4">
									<TextBlock Text="{x:Static local:Strings.Main_InputFileS}" Classes="infoLabel" Margin="0" />
									<TextBlock Text="{x:Static local:Strings.Main_AddSeveralSegmentsOfThe}"
									           Classes="infoLabel" Margin="0,0,0,4" FontSize="12" Opacity="0.4"
									           TextWrapping="Wrap" />
									<ListBox Name="InputFilesList" MinHeight="40" MaxHeight="136" SelectionMode="Single">
										<ListBox.ItemTemplate>
											<DataTemplate x:DataType="x:String">
												<TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
									<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
										<Button Grid.Column="0" Content="{x:Static local:Strings.Main_Add}" Click="OnAddInputFilesClick"
										        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
										<Button Grid.Column="1" Classes="iconButton" Click="OnMoveInputUpClick" ToolTip.Tip="{x:Static local:Strings.Main_MoveUp}">
											<local:IconView Data="{StaticResource IconArrowUp}" Width="14" Height="14" />
										</Button>
										<Button Grid.Column="2" Classes="iconButton" Click="OnMoveInputDownClick" ToolTip.Tip="{x:Static local:Strings.Main_MoveDown}">
											<local:IconView Data="{StaticResource IconArrowDown}" Width="14" Height="14" />
										</Button>
										<Button Grid.Column="3" Content="{x:Static local:Strings.Main_Remove}" Click="OnRemoveInputClick" />
									</Grid>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="{x:Static local:Strings.Main_OutputFile}" Classes="infoLabel" Margin="0" />
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBox Grid.Column="0" Name="OutputPathBox" />
										<Button Grid.Column="1" Content="{x:Static local:Strings.Common_Browse}" Click="OnPickOutputClick" />
									</Grid>
								</StackPanel>

								<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
									<Button Grid.Column="0" Content="{x:Static local:Strings.Main_OpenProject}" Click="OnOpenProjectClick"
									        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
									<Button Grid.Column="1" Content="{x:Static local:Strings.Main_Save}" Click="OnSaveProjectClick" ToolTip.Tip="{x:Static local:Strings.Main_SaveTheProjectCtrlS}"
									        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
									<Button Grid.Column="2" Content="{x:Static local:Strings.Main_SaveAs}" Click="OnSaveProjectAsClick" ToolTip.Tip="{x:Static local:Strings.Main_SaveAsANewFile}"
									        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
								</Grid>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
									<Button Grid.Column="0" Content="{x:Static local:Strings.Common_Settings}" Click="OnSettingsClick"
									        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
									<Button Grid.Column="1" Content="{x:Static local:Strings.Common_Tools}" Click="OnToolsClick"
									        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
								</Grid>
							</StackPanel>
						</Border>

						<Border Classes="card">
							<StackPanel Spacing="8">
								<StackPanel Classes="cardTitle">
									<TextBlock Classes="cardTitleText" Text="{x:Static local:Strings.Main_Action}" />
								</StackPanel>

								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<Button Grid.Column="0" Name="ActionButton" Content="{x:Static local:Strings.Main_GetSummary}" Click="OnActionClick"
									        Classes="accent" IsEnabled="False" HorizontalAlignment="Stretch"
									        HorizontalContentAlignment="Center" />
									<Button Grid.Column="1" Name="GreenScreenButton" Content="{x:Static local:Strings.Main_GreenScreen}"
									        Click="OnGreenScreenRenderClick" IsEnabled="False" IsVisible="False"
									        HorizontalContentAlignment="Center"
									        ToolTip.Tip="{x:Static local:Strings.Main_RenderJustTheHudOverlay}" />
									<Button Grid.Column="0" Grid.ColumnSpan="2" Name="CancelButton" Content="{x:Static local:Strings.Common_Cancel}"
									        Click="OnCancelClick" IsVisible="False" HorizontalAlignment="Stretch"
									        HorizontalContentAlignment="Center" />
								</Grid>
								<ProgressBar Name="Progress" Minimum="0" Maximum="100" Height="16" IsVisible="False" />
							</StackPanel>
						</Border>

						<StackPanel Name="SummaryPanel" Spacing="10" IsVisible="False" Grid.IsSharedSizeScope="True">

							<Border Classes="card" Name="FileInfoCard" IsVisible="False">
								<StackPanel Spacing="2">
									<StackPanel Classes="cardTitle">
										<TextBlock Classes="cardTitleText" Text="{x:Static local:Strings.Main_Input}" />
									</StackPanel>

									<Grid RowDefinitions="Auto,Auto" RowSpacing="2"
									      ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Camera}" />
										<TextBlock Grid.Row="0" Grid.Column="1" Classes="infoValue" Name="InfoCamera" />
										<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Telemetry}" />
										<Border Grid.Row="0" Grid.Column="4" Classes="pill" Name="TelemetryPill"
										        HorizontalAlignment="Left">
											<TextBlock Name="InfoTelemetry" FontWeight="SemiBold" FontSize="12" />
										</Border>

										<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Duration}" />
										<TextBlock Grid.Row="1" Grid.Column="1" Classes="infoValue" Name="InfoDuration" />
										<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_FileSize}" />
										<TextBlock Grid.Row="1" Grid.Column="4" Classes="infoValue" Name="InfoFileSize" />
									</Grid>

									<TextBlock Text="{x:Static local:Strings.Main_VideoHeader}" Classes="sectionLabel" />
									<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2"
									      ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Resolution}" />
										<StackPanel Background="Transparent" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoResolution" Margin="0" />
											<local:IconView Classes="checkIcon" Name="InfoResolutionCheck" />
										</StackPanel>
										<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_FrameRate}" />
										<StackPanel Background="Transparent" Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoFrameRate" Margin="0" />
											<local:IconView Classes="checkIcon" Name="InfoFrameRateCheck" />
										</StackPanel>

										<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Codec}" />
										<StackPanel Background="Transparent" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoCodec" Margin="0" />
											<local:IconView Classes="checkIcon" Name="InfoCodecCheck" />
										</StackPanel>
										<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Bitrate}" />
										<StackPanel Background="Transparent" Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoBitrate" Margin="0" />
											<local:IconView Classes="checkIcon" Name="InfoBitrateCheck" />
										</StackPanel>

										<TextBlock Grid.Row="2" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Common_Color}" />
										<StackPanel Background="Transparent" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoColor" Margin="0" TextWrapping="Wrap" />
											<local:IconView Classes="checkIcon" Name="InfoColorCheck" />
										</StackPanel>
									</Grid>

									<TextBlock Text="{x:Static local:Strings.Main_AudioHeader}" Classes="sectionLabel" />
									<Grid Name="AudioGrid" RowDefinitions="Auto,Auto"
									      RowSpacing="2" ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Codec}" />
										<TextBlock Grid.Row="0" Grid.Column="1" Classes="infoValue" Name="InfoAudioCodec" />
										<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_SampleRate}" />
										<TextBlock Grid.Row="0" Grid.Column="4" Classes="infoValue" Name="InfoAudioSampleRate" />

										<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Channels}" />
										<TextBlock Grid.Row="1" Grid.Column="1" Classes="infoValue" Name="InfoAudioChannels" />
										<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Bitrate}" />
										<StackPanel Background="Transparent" Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="10"
										            VerticalAlignment="Center">
											<TextBlock Classes="infoValue" Name="InfoAudioBitrate" Margin="0" />
											<local:IconView Classes="checkIcon" Name="InfoAudioBitrateCheck" />
										</StackPanel>
									</Grid>
									<TextBlock Name="InfoAudioNone" Classes="infoValue" Text="{x:Static local:Strings.Main_None}" IsVisible="False" />
								</StackPanel>
							</Border>

							<Border Classes="card" Name="TelemetryCard" IsVisible="False">
								<StackPanel Spacing="4">
									<StackPanel Classes="cardTitle">
										<TextBlock Classes="cardTitleText" Text="{x:Static local:Strings.Main_TelemetryHeader}" />
									</StackPanel>
									<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Samples}" />
										<TextBlock Grid.Row="0" Grid.Column="1" Classes="infoValue" Name="TeleSamples" />
										<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Duration}" />
										<TextBlock Grid.Row="0" Grid.Column="4" Classes="infoValue" Name="TeleDuration" />

										<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Distance}" />
										<TextBlock Grid.Row="1" Grid.Column="1" Classes="infoValue" Name="TeleDistance" />
										<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Common_MaxSpeed}" />
										<TextBlock Grid.Row="1" Grid.Column="4" Classes="infoValue" Name="TeleMaxSpeed" />

										<TextBlock Grid.Row="2" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Altitude}" />
										<TextBlock Grid.Row="2" Grid.Column="1" Classes="infoValue" Name="TeleAltitude" />
										<TextBlock Grid.Row="2" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_MaxGForce}" />
										<TextBlock Grid.Row="2" Grid.Column="4" Classes="infoValue" Name="TeleMaxG" />
									</Grid>
									<TextBlock Classes="infoLabel" Margin="0,10,0,0">
										<Run Text="{x:Static local:Strings.Main_Recorded}" /><Run Text=" " /><Run Name="TeleRecordedAt" />
									</TextBlock>
								</StackPanel>
							</Border>

							<Border Classes="card" Name="OutputInfoCard" IsVisible="False">
								<StackPanel Spacing="4">
									<StackPanel Classes="cardTitle">
										<TextBlock Classes="cardTitleText" Text="{x:Static local:Strings.Main_Output}" />
									</StackPanel>
									<Grid RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Encoder}" />
										<TextBlock Grid.Row="0" Grid.Column="1" Classes="infoValue" Name="OutEncoder" />
										<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Audio}" />
										<TextBlock Grid.Row="0" Grid.Column="4" Classes="infoValue" Name="OutAudio" TextWrapping="Wrap" />
										<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Frames}" Name="OutFrameCountLabel" />
										<TextBlock Grid.Row="1" Grid.Column="1" Classes="infoValue" Name="OutFrameCount" />
										<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_EstRenderTime}" Name="OutEstimatedTimeLabel" />
										<TextBlock Grid.Row="1" Grid.Column="4" Classes="infoValue" Name="OutEstimatedTime" />
									</Grid>

									<TextBlock Name="OutPlanText" Classes="infoLabel" Margin="0,6,0,0" FontSize="11" Opacity="0.6"
									           TextWrapping="Wrap" />

									<StackPanel Name="OutMeasuredPanel" Spacing="4" IsVisible="False">
										<TextBlock Text="{x:Static local:Strings.Main_MeasuredExportedFile}" Classes="sectionLabel" />
										<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="24" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Resolution}" />
											<StackPanel Background="Transparent" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutResolution" Margin="0" />
												<local:IconView Classes="checkIcon" Name="OutResolutionCheck" />
											</StackPanel>
											<TextBlock Grid.Row="0" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_FrameRate}" />
											<StackPanel Background="Transparent" Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutFrameRate" Margin="0" />
												<local:IconView Classes="checkIcon" Name="OutFrameRateCheck" />
											</StackPanel>

											<TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Codec}" />
											<StackPanel Background="Transparent" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutCodec" Margin="0" />
												<local:IconView Classes="checkIcon" Name="OutCodecCheck" />
											</StackPanel>
											<TextBlock Grid.Row="1" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_Bitrate}" />
											<StackPanel Background="Transparent" Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutBitrate" Margin="0" />
												<local:IconView Classes="checkIcon" Name="OutBitrateCheck" />
											</StackPanel>

											<TextBlock Grid.Row="2" Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_PixelFormat}" />
											<StackPanel Background="Transparent" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutPixFmt" Margin="0" />
												<local:IconView Classes="checkIcon" Name="OutPixFmtCheck" />
											</StackPanel>
											<TextBlock Grid.Row="2" Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Common_Color}" />
											<StackPanel Background="Transparent" Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Spacing="10"
											            VerticalAlignment="Center">
												<TextBlock Classes="infoValue" Name="OutColor" Margin="0" TextWrapping="Wrap" />
												<local:IconView Classes="checkIcon" Name="OutColorCheck" />
											</StackPanel>
										</Grid>

										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelLeft" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="24" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabelRight" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Classes="infoLabel" Text="{x:Static local:Strings.Main_Duration}" />
											<TextBlock Grid.Column="1" Classes="infoValue" Name="OutMeasuredDuration" />
											<TextBlock Grid.Column="3" Classes="infoLabel" Text="{x:Static local:Strings.Main_FileSize}" />
											<TextBlock Grid.Column="4" Classes="infoValue" Name="OutMeasuredFileSize" />
										</Grid>
									</StackPanel>
								</StackPanel>
							</Border>

						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="WidgetSettingsColumnScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
					<StackPanel Spacing="10">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Grid.Column="0" Name="WidgetSettingsBackButton" Classes="toolbar"
							        Padding="10,7" FontSize="12" HorizontalAlignment="Left"
							        Click="OnWidgetSettingsBackClick">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<local:IconView Data="{StaticResource IconArrowLeft}" Width="12" Height="12" VerticalAlignment="Center" />
									<TextBlock Text="{x:Static local:Strings.Common_Back}" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<TextBlock Grid.Column="1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
								<Run Text="{x:Static local:Strings.Main_WidgetSettingsHeader}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
								<Run Name="WidgetSettingsTitleRun" Text="{x:Static local:Strings.Main_WidgetSettings}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
							</TextBlock>
							<Button Grid.Column="2" Name="WidgetSettingsResetButton" Classes="toolbar"
							        Content="{x:Static local:Strings.Main_ResetToDefault}" Padding="10,7" FontSize="12" HorizontalAlignment="Right"
							        Click="OnResetElementClick" />
						</Grid>
						<Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,2" />
						<ContentControl Name="WidgetSettingsPanelHost" HorizontalContentAlignment="Stretch" />
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="CutsColumnScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
					<StackPanel Spacing="10">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Grid.Column="0" Classes="toolbar" Padding="10,7" FontSize="12" HorizontalAlignment="Left"
							        Click="OnCutsBackClick">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<local:IconView Data="{StaticResource IconArrowLeft}" Width="12" Height="12" VerticalAlignment="Center" />
									<TextBlock Text="{x:Static local:Strings.Common_Back}" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<TextBlock Grid.Column="1" Text="{x:Static local:Strings.Main_Cuts}" FontSize="14" FontWeight="SemiBold"
							           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Button Grid.Column="2" Classes="toolbar" Content="{x:Static local:Strings.Common_ClearAll}" Padding="10,7" FontSize="12"
							        HorizontalAlignment="Right" Click="OnClearCutsClick" ToolTip.Tip="{x:Static local:Strings.Main_RemoveEveryCutRenderThe}" />
						</Grid>
						<Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,2" />
						<local:CutEditor Name="CutsEditor" />
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="MomentsColumnScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" IsVisible="False">
					<StackPanel Spacing="10">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Grid.Column="0" Classes="toolbar" Padding="10,7" FontSize="12" HorizontalAlignment="Left"
							        Click="OnMomentsBackClick">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<local:IconView Data="{StaticResource IconArrowLeft}" Width="12" Height="12" VerticalAlignment="Center" />
									<TextBlock Text="{x:Static local:Strings.Common_Back}" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<TextBlock Grid.Column="1" Text="{x:Static local:Strings.Main_KeyMoments}" FontSize="14" FontWeight="SemiBold"
							           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Button Grid.Column="2" Classes="toolbar" Content="{x:Static local:Strings.Common_ClearAll}" Padding="10,7" FontSize="12"
							        HorizontalAlignment="Right" Click="OnClearMomentsClick" ToolTip.Tip="{x:Static local:Strings.Main_RemoveEveryKeyMoment}" />
						</Grid>
						<Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,2" />
						<local:KeyMomentsEditor Name="MomentsEditor" />
					</StackPanel>
				</ScrollViewer>
			</Grid>

			<Border Grid.Column="1" Classes="card" Name="PreviewCard">
				<Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
					<Grid Grid.Row="0" Height="32">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
							<ComboBox Name="PreviewQualityCombo" VerticalAlignment="Center" MinWidth="150"
							          FontSize="12" Padding="10,4" SelectionChanged="OnPreviewQualityChanged"
							          ToolTip.Tip="{x:Static local:Strings.Main_PreviewQualityHowSharpThe}" />
							<ComboBox Name="PreviewZoomCombo" VerticalAlignment="Center" MinWidth="80"
							          FontSize="12" Padding="10,4" SelectionChanged="OnPreviewZoomChanged"
							          ToolTip.Tip="{x:Static local:Strings.Main_PreviewZoom100IsOne}" />
							<Button Name="FullscreenButton" Classes="previewToolButton comboLike" Click="OnToggleFullscreenClick"
							        Width="{Binding #PreviewQualityCombo.Bounds.Height}" Height="{Binding #PreviewQualityCombo.Bounds.Height}"
							        ToolTip.Tip="{x:Static local:Strings.Main_FullScreenPreviewF11On}">
								<local:IconView Data="{StaticResource IconFullscreen}" Width="14" Height="14" />
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
							<Button Name="ToggleGridButton" Classes="previewToolButton active"
							        ToolTip.Tip="{x:Static local:Strings.Main_GridGuides}">
								<local:IconView Data="{StaticResource IconGrid}" Width="14" Height="14" />
								<Button.Flyout>
									<Flyout Placement="Bottom">
										<StackPanel Spacing="4" Width="150">
											<Button Name="GridModeOffButton" Classes="toolbar" Content="{x:Static local:Strings.Main_Off}"
											        Click="OnGridModeClick" />
											<Button Name="GridModeThirdsButton" Classes="toolbar" Content="{x:Static local:Strings.Main_RuleOfThirds}"
											        Click="OnGridModeClick" />
											<Button Name="GridModeMarginButton" Classes="toolbar" Content="{x:Static local:Strings.Main_SafeMargin}"
											        Click="OnGridModeClick" />
											<Button Name="GridModeBothButton" Classes="toolbar active" Content="{x:Static local:Strings.Main_ThirdsMargin}"
											        Click="OnGridModeClick" />
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
							<Button Name="ToggleSnapButton" Classes="previewToolButton active" Click="OnToggleSnapClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_SnapWidgetsToGrid}">
								<local:IconView Data="{StaticResource IconSnap}" Width="14" Height="14" />
							</Button>
							<Button Name="ToggleReframeButton" Classes="previewToolButton" Click="OnToggleReframeClick" IsVisible="False"
							        ToolTip.Tip="{x:Static local:Strings.Main_FrameThe360ViewDrag}">
								<local:IconView Data="{StaticResource IconSphere}" Width="14" Height="14" />
							</Button>
							<Button Name="ToggleLevelButton" Classes="previewToolButton active" Click="OnToggleLevelClick" IsVisible="False"
							        ToolTip.Tip="{x:Static local:Strings.Main_KeepThe360ViewLevel}">
								<local:IconView Data="{StaticResource IconHorizon}" Width="14" Height="14" />
							</Button>
							<Button Name="ToggleOverlayButton" Classes="previewToolButton active" Click="OnToggleOverlayClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_ShowTheOverlayHOff}">
								<local:IconView Data="{StaticResource IconEye}" Width="14" Height="14" />
							</Button>
							<Button Name="SnapshotButton" Classes="previewToolButton" Click="OnSnapshotClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_SaveTheFrameOnScreen}">
								<local:IconView Data="{StaticResource IconCamera}" Width="14" Height="14" />
							</Button>
							<Button Name="TimeFormatButton" Classes="previewToolButton"
							        ToolTip.Tip="{x:Static local:Strings.Main_TimeFormatMinutesAndSeconds}">
								<local:IconView Data="{StaticResource IconStopwatch}" Width="14" Height="14" />
								<Button.Flyout>
									<Flyout Placement="Bottom">
										<StackPanel Name="TimeFormatMenu" Spacing="4" Width="170" />
									</Flyout>
								</Button.Flyout>
							</Button>
							<Button Name="ToggleTimelineButton" Classes="previewToolButton" Click="OnToggleTimelineClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_TimelineWithThumbnailsAndAudio}">
								<local:IconView Data="{StaticResource IconTimeline}" Width="14" Height="14" />
							</Button>
							<Button Name="ToggleCutsButton" Classes="previewToolButton" Click="OnToggleCutsPanelClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_CutPartsOutOfThe}">
								<local:IconView Data="{StaticResource IconCut}" Width="14" Height="14" />
							</Button>
							<Button Name="ToggleMomentsButton" Classes="previewToolButton" Click="OnToggleMomentsPanelClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_KeyMomentsFlagsOnThe}">
								<local:IconView Data="{StaticResource IconFlag}" Width="14" Height="14" />
							</Button>
						</StackPanel>
						<StackPanel Name="AudioPanel" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
						            IsEnabled="False" ToolTip.ShowOnDisabled="True">
							<Button Name="MuteButton" Classes="previewToolButton" VerticalAlignment="Center" Click="OnMuteClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_UnmuteM}">
								<Panel Width="14" Height="14">
									<local:IconView Name="MuteIcon" Data="{StaticResource IconVolumeMuted}" />
									<local:IconView Name="MuteSlash" Data="{StaticResource IconMuteSlash}" Foreground="{StaticResource DangerHoverBrush}" />
								</Panel>
							</Button>
							<Slider Name="VolumeSlider" Classes="compact" Minimum="0" Maximum="1" Width="90" VerticalAlignment="Center"
							        ValueChanged="OnVolumeChanged" ToolTip.Tip="{x:Static local:Strings.Main_PreviewVolume}" />
						</StackPanel>
					</Grid>
					<Border Grid.Row="1" Name="PreviewFullscreenNotice" Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6"
					        IsVisible="False">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
							<local:IconView Data="{StaticResource IconFullscreen}" Width="28" Height="28" Opacity="0.5"
							                HorizontalAlignment="Center" />
							<TextBlock Name="PreviewFullscreenNoticeTitle" Text="{x:Static local:Strings.Main_ThePreviewIsFullScreen}" FontSize="14" HorizontalAlignment="Center" />
							<TextBlock Name="PreviewFullscreenNoticeText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
							           TextAlignment="Center" />
							<Button Content="{x:Static local:Strings.Main_BringItBack}" HorizontalAlignment="Center" Padding="14,6" Click="OnToggleFullscreenClick" />
						</StackPanel>
					</Border>
					<Border Grid.Row="1" Name="PreviewViewport" Background="Black" CornerRadius="6" ClipToBounds="True">
						<Grid>
							<Canvas>
								<local:VideoView Name="PreviewVideo" />
							</Canvas>
							<Border Name="CutScrim" Background="{StaticResource ScrimBrush}" IsVisible="False" IsHitTestVisible="False">
								<Border Background="{StaticResource OnVideoBrush}" BorderBrush="{StaticResource OnVideoBorderBrush}" BorderThickness="1"
								        CornerRadius="6" Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<local:IconView Data="{StaticResource IconCut}" Width="14" Height="14" VerticalAlignment="Center" />
										<TextBlock Text="{x:Static local:Strings.Main_CutOutNotInThe}" FontWeight="SemiBold" VerticalAlignment="Center" />
									</StackPanel>
								</Border>
							</Border>
							<Canvas Name="OverlayDragCanvas" Background="Transparent"
							        DragDrop.AllowDrop="True"
							        PointerPressed="OnOverlayCanvasPointerPressed"
							        PointerMoved="OnOverlayCanvasPointerMoved"
							        PointerReleased="OnOverlayCanvasPointerReleased"
							        PointerCaptureLost="OnOverlayCanvasPointerCaptureLost"
							        PointerExited="OnOverlayCanvasPointerExited"
							        DragDrop.DragOver="OnOverlayCanvasDragOver"
							        DragDrop.Drop="OnOverlayCanvasDrop">
								<Line Name="PreviewGridVLine1" Classes="previewGuide" IsHitTestVisible="False" IsVisible="False" />
								<Line Name="PreviewGridVLine2" Classes="previewGuide" IsHitTestVisible="False" IsVisible="False" />
								<Line Name="PreviewGridHLine1" Classes="previewGuide" IsHitTestVisible="False" IsVisible="False" />
								<Line Name="PreviewGridHLine2" Classes="previewGuide" IsHitTestVisible="False" IsVisible="False" />
								<Rectangle Name="PreviewSafeMarginBox" Classes="previewGuide" IsHitTestVisible="False" IsVisible="False" />

								<Rectangle Name="HoverOutline" Classes="hoverOutline" IsHitTestVisible="False" />
								<Border Name="SelectionHighlightBox" Classes="selectionHighlight" IsHitTestVisible="False" IsVisible="False" />
								<Border Name="HoverLabel" Classes="hoverLabel" IsHitTestVisible="False">
									<TextBlock Name="HoverLabelText" />
								</Border>
								<Ellipse Name="ResizeHandle" Classes="resizeHandle" IsVisible="False"
								         PointerPressed="OnResizeHandlePointerPressed"
								         ToolTip.Tip="{x:Static local:Strings.Main_DragToResize}" />

								<Button Name="WidgetGearHoverButton" Classes="widgetHoverButton widgetGearButton"
								        IsVisible="False" Click="OnWidgetGearHoverButtonClick"
								        ToolTip.Tip="{x:Static local:Strings.Main_WidgetSettings}">
									<local:IconView Data="{StaticResource IconGear}" Width="11" Height="11" />
								</Button>
								<Button Name="RemoveWidgetButton" Classes="widgetHoverButton removeWidgetButton"
								        IsVisible="False" Click="OnRemoveWidgetButtonClick"
								        ToolTip.Tip="{x:Static local:Strings.Main_RemoveFromOverlay}">
									<local:IconView Data="{StaticResource IconClose}" Width="9" Height="9" />
								</Button>
							</Canvas>
							<StackPanel Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
								<Image Source="{local:AssetImage Path=EmptyPreview.webp}" Width="260" Margin="0,0,0,6" />
								<TextBlock Text="{x:Static local:Strings.Main_NoVideoLoaded}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
								<TextBlock Text="{x:Static local:Strings.Main_PickADjiOsmoAction}"
								           Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"
								           MaxWidth="320" TextAlignment="Center" />
								<Button Content="{x:Static local:Strings.Common_OpenARecording}" Classes="accent" HorizontalAlignment="Center" Margin="0,4,0,0"
								        Click="OnAddInputFilesClick" />
							</StackPanel>
						</Grid>
					</Border>

					<Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
						<StackPanel Grid.Column="0" Name="TransportPanel" Orientation="Horizontal" Spacing="4" IsEnabled="False">
							<Button Classes="transport" Click="OnGoToStartClick" ToolTip.Tip="{x:Static local:Strings.Main_GoToStartHome}">
								<local:IconView Data="{StaticResource IconSkipStart}" Width="14" Height="14" />
							</Button>
							<Button Classes="transport" Click="OnPreviousFrameClick" ToolTip.Tip="{x:Static local:Strings.Main_PreviousFrameLeft}">
								<local:IconView Data="{StaticResource IconFramePrevious}" Width="14" Height="14" />
							</Button>
							<Button Name="PlayPauseButton" Classes="transport" Click="OnPlayPauseClick" ToolTip.Tip="{x:Static local:Strings.Main_PlaySpace}">
								<local:IconView Name="PlayPauseIcon" Data="{StaticResource IconPlay}" Width="14" Height="14" />
							</Button>
							<Button Classes="transport" Click="OnNextFrameClick" ToolTip.Tip="{x:Static local:Strings.Main_NextFrameRight}">
								<local:IconView Data="{StaticResource IconFrameNext}" Width="14" Height="14" />
							</Button>
							<Button Classes="transport" Click="OnGoToEndClick" ToolTip.Tip="{x:Static local:Strings.Main_GoToEndEnd}">
								<local:IconView Data="{StaticResource IconSkipEnd}" Width="14" Height="14" />
							</Button>
							<Button Name="LoopButton" Classes="transport" Click="OnLoopClick"
							        ToolTip.Tip="{x:Static local:Strings.Main_LoopPlaybackQTheIn}">
								<local:IconView Data="{StaticResource IconLoop}" Width="14" Height="14" />
							</Button>
							<ComboBox Name="SpeedCombo" Width="74" FontSize="12" Padding="8,4" VerticalAlignment="Center" Margin="4,0,0,0"
							          SelectionChanged="OnSpeedChanged"
							          ToolTip.Tip="{x:Static local:Strings.Main_PlaybackSpeedJSlowerK}" />
						</StackPanel>
						<local:PreviewTimeline Grid.Column="1" Name="PreviewTimeline" Minimum="0" Maximum="1" IsEnabled="False"
						                       VerticalAlignment="Center" ValueChanged="OnPreviewTimelineValueChanged" />
						<TextBlock Grid.Column="2" Name="PreviewTimeText" Classes="infoLabel" Margin="0" FontFeatures="+tnum" TextAlignment="Right"
						           VerticalAlignment="Center" Text="00:00 / 00:00" Background="Transparent" Cursor="Hand"
						           PointerPressed="OnPreviewTimeTextPressed" ToolTip.Tip="{x:Static local:Strings.Main_ClickToSwitchTheTime}" />
						<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Name="PreviewStatusBar" Margin="0,8,0,0" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center"
						            VerticalAlignment="Center" IsVisible="False">
							<StackPanel Classes="previewStatus" ToolTip.Tip="{x:Static local:Strings.Main_RecordingTheSourceVideoS}">
								<local:IconView Data="{StaticResource IconFile}" />
								<TextBlock Name="StatusSourceText" />
							</StackPanel>
							<StackPanel Classes="previewStatus"
							            ToolTip.Tip="{x:Static local:Strings.Main_PreviewTheResolutionThePreview}">
								<local:IconView Data="{StaticResource IconMonitor}" />
								<TextBlock Name="StatusPreviewText" />
							</StackPanel>
							<StackPanel Classes="previewStatus" Name="StatusReframePanel" IsVisible="False"
							            ToolTip.Tip="{x:Static local:Strings.Main_360ViewWhereTheFlat}">
								<local:IconView Data="{StaticResource IconSphere}" />
								<TextBlock Name="StatusReframeText" />
							</StackPanel>
							<StackPanel Classes="previewStatus" ToolTip.Tip="{x:Static local:Strings.Main_CurrentFrameTheNumberOf}">
								<local:IconView Data="{StaticResource IconFrameCurrent}" />
								<TextBlock Name="StatusFrameText" MinWidth="50" />
							</StackPanel>
							<StackPanel Classes="previewStatus"
							            ToolTip.Tip="{x:Static local:Strings.Main_DisplayThePreviewSSize}">
								<local:IconView Data="{StaticResource IconDisplay}" />
								<TextBlock Name="StatusDisplayText" MinWidth="118" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>

			<Border Grid.Column="2" Classes="card" Name="OverlayCard">
				<Grid RowDefinitions="Auto,Auto,*">
