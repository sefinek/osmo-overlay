<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:OsmoOverlay.Gui"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="640"
        x:Class="OsmoOverlay.Gui.SettingsWindow"
        Width="920" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="/Assets/OsmoOverlay.ico"
        Title="Settings">

	<Window.Resources>
		<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource SurfaceInsetColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{StaticResource ControlColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{StaticResource ControlPressedColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="{StaticResource SurfaceInsetColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource ControlBorderColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="{StaticResource ControlBorderHoverColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="{StaticResource ControlBorderHoverColor}" />
		<SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="{StaticResource ControlBorderColor}" />
		<SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource SurfaceInsetColor}" />
		<SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{StaticResource ControlBorderColor}" />
		<SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
		<SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
	</Window.Resources>

	<Window.Styles>
		<!-- Sidebar -->
		<Style Selector="ListBox#CategoryList">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem">
			<Setter Property="Padding" Value="12,9" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Margin" Value="0,0,0,2" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:pointerover">
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:selected">
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem StackPanel">
			<Setter Property="RenderTransform" Value="translateX(0px)" />
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:pointerover StackPanel">
			<Setter Property="RenderTransform" Value="translateX(3px)" />
		</Style>

		<Style Selector="ScrollViewer.page.hidden">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ListBox#CategoryList ListBoxItem:selected local|IconView">
			<Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
		</Style>

		<!-- Page -->
		<Style Selector="TextBlock.pageTitle">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style Selector="TextBlock.pageSubtitle">
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="Margin" Value="4,6,0,-4" />
		</Style>

		<!-- A card of setting rows: title and description on the left, the control on the right -->
		<Style Selector="Border.settingsCard">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
		<Style Selector="Border.divider">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
		</Style>
		<Style Selector="Grid.settingRow">
			<Setter Property="Margin" Value="16,13" />
			<Setter Property="ColumnSpacing" Value="24" />
		</Style>
		<Style Selector="Panel.settingBlock, StackPanel.settingBlock">
			<Setter Property="Margin" Value="16,13" />
		</Style>
		<Style Selector="TextBlock.rowTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.rowHint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="17" />
			<Setter Property="Margin" Value="0,3,0,0" />
		</Style>
		<Style Selector="Grid.settingRow > ComboBox, Grid.settingRow > NumericUpDown">
			<Setter Property="Width" Value="230" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="ToggleSwitch">
			<Setter Property="OnContent" Value="" />
			<Setter Property="OffContent" Value="" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="CheckBox, RadioButton">
			<Setter Property="Padding" Value="8,0,0,0" />
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="210,*">
		<!-- Sidebar -->
		<Border Grid.Column="0" Background="{StaticResource SurfaceSunkenBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
			<DockPanel Margin="12,18,12,14">
				<TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="18" FontWeight="Bold" Margin="10,0,0,14" />
				<TextBlock DockPanel.Dock="Bottom" Name="SidebarVersionText" Classes="hint" Margin="10,0,0,0" />
				<ListBox Name="CategoryList" SelectedIndex="0" SelectionChanged="OnCategoryChanged">
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconDisplay}" Width="16" Height="16" />
							<TextBlock Text="Rendering" />
						</StackPanel>
					</ListBoxItem>
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconStopwatch}" Width="16" Height="16" />
							<TextBlock Text="Speed" />
						</StackPanel>
					</ListBoxItem>
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconFlag}" Width="16" Height="16" />
							<TextBlock Text="Route intro" />
						</StackPanel>
					</ListBoxItem>
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconEye}" Width="16" Height="16" />
							<TextBlock Text="Interface" />
						</StackPanel>
					</ListBoxItem>
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconGear}" Width="16" Height="16" />
							<TextBlock Text="Behavior" />
						</StackPanel>
					</ListBoxItem>
					<ListBoxItem>
						<StackPanel Orientation="Horizontal" Spacing="12">
							<local:IconView Data="{StaticResource IconInfo}" Width="16" Height="16" />
							<TextBlock Text="About" />
						</StackPanel>
					</ListBoxItem>
				</ListBox>
			</DockPanel>
		</Border>

		<Grid Grid.Column="1">
			<!-- Rendering -->
			<ScrollViewer Name="RenderingPanel" Classes="page" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<StackPanel>
						<TextBlock Text="Rendering" Classes="pageTitle" />
						<TextBlock Classes="pageSubtitle"
						           Text="By default a render matches the source's own encoding 1:1 - bitrate, keyframe interval, HEVC level and no B-frames. Only a non-default choice here changes that." />
					</StackPanel>

					<TextBlock Text="OVERLAY" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Attribution watermark" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="'Made with OsmoOverlay' and the project link at the bottom for the first few seconds, fading out." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="ShowWatermarkCheck" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Smooth GPS-derived motion" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="The GPS reports a few fixes a second, so the compass trail and map hold, then jump. This interpolates between fixes. Applies the next time a recording opens." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="SmoothGpsMotionCheck" />
							</Grid>
						</StackPanel>
					</Border>

					<TextBlock Text="OUTPUT QUALITY" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Encoder preset (NVIDIA GPU)" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="Effort per frame at the same bitrate. P7 looks best (default); lower ones are faster. NVENC only - the CPU encoder has its own." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="NvencPresetCombo" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Output bitrate" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="Higher makes a bigger file but keeps thin HUD text crisper after YouTube and the like re-compress it." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="BitrateCombo" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Decode the source on the GPU" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="Several times faster, identical frames. Turn it off only if renders fail after a driver update or on an unusual GPU." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="HardwareDecodingCheck" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Fast start for web playback" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="Puts the index first, so a browser or messenger can play it before it's all downloaded. Same picture; an extra pass of a few seconds per GB." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="FastStartCheck" />
							</Grid>
						</StackPanel>
					</Border>

					<TextBlock Text="PRIVACY" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Keep the camera's metadata" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="Copies what the camera recorded alongside the video into the render, so DJI Mimo, exiftool or this app can still read it. Pick below what to keep." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="PreserveCameraMetadataCheck" IsCheckedChanged="OnMetadataOptionChanged" />
							</Grid>
							<StackPanel Classes="settingBlock" Margin="16,0,16,14">
								<Expander Name="MetadataPartsExpander" HorizontalAlignment="Stretch" CornerRadius="8">
									<StackPanel Spacing="12">
										<StackPanel Spacing="2">
											<CheckBox Name="MetadataTelemetryCheck" Content="Telemetry - GPS route, speed, accelerometer, exposure"
											          IsCheckedChanged="OnMetadataOptionChanged" />
											<TextBlock Classes="rowHint" Margin="28,0,0,0"
											           Text="What DJI Mimo and this app read the ride from. Includes your exact position for every frame." />
										</StackPanel>
										<StackPanel Spacing="2">
											<CheckBox Name="MetadataSerialCheck" Content="Camera serial number and device ID"
											          IsCheckedChanged="OnMetadataOptionChanged" />
											<TextBlock Classes="rowHint" Margin="28,0,0,0"
											           Text="Identifies your camera; nothing that reads the telemetry needs it. Off, it's removed from the file entirely." />
										</StackPanel>
										<StackPanel Spacing="2">
											<CheckBox Name="MetadataDebugCheck" Content="Camera debug track"
											          IsCheckedChanged="OnMetadataOptionChanged" />
											<TextBlock Classes="rowHint" Margin="28,0,0,0"
											           Text="DJI's internal sensor diagnostics (~1.7 Mbps). No location in it, and no common tool reads it." />
										</StackPanel>
										<StackPanel Spacing="2">
											<CheckBox Name="MetadataThumbnailsCheck" Content="Thumbnails and recording info"
											          IsCheckedChanged="OnMetadataOptionChanged" />
											<TextBlock Classes="rowHint" Margin="28,0,0,0"
											           Text="Cover image, camera model, shooting settings and the file's original name on the camera." />
										</StackPanel>
									</StackPanel>
								</Expander>
							</StackPanel>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- Speed -->
			<ScrollViewer Name="SpeedPanel" Classes="page hidden" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<StackPanel>
						<TextBlock Text="Speed calibration" Classes="pageTitle" />
						<TextBlock Classes="pageSubtitle"
						           Text="A camera's GPS tends to read speed low. The correction raises every shown speed - the speed widgets, top and average speed, the route intro - in the preview and in every render. One setting for all recordings, saved when you close Settings." />
					</StackPanel>
					<Border Classes="settingsCard" Padding="16">
						<local:SpeedCalibrationEditor Name="SpeedEditor" />
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- Route intro -->
			<ScrollViewer Name="RouteIntroPanel" Classes="page hidden" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<StackPanel>
						<TextBlock Text="Route intro" Classes="pageTitle" />
						<TextBlock Classes="pageSubtitle"
						           Text="A fullscreen card for the first seconds of the render: the whole route on a map and the trip stats. Needs a GPS fix and network access for the map." />
					</StackPanel>

					<Border Classes="settingsCard">
						<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
							<StackPanel>
								<TextBlock Text="Show the route overview at the start" Classes="rowTitle" />
								<TextBlock Classes="rowHint" Text="Everything below applies only while this is on." />
							</StackPanel>
							<ToggleSwitch Grid.Column="1" Name="ShowRouteIntroCheck" Click="OnShowRouteIntroChanged" />
						</Grid>
					</Border>

					<StackPanel Name="RouteIntroOptionsPanel" Spacing="14">
						<TextBlock Text="CARD" Classes="sectionLabel" />
						<Border Classes="settingsCard">
							<StackPanel>
								<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
									<TextBlock Name="RouteIntroDurationLabel" Text="Duration (seconds)" Classes="rowTitle" VerticalAlignment="Center" />
									<NumericUpDown Grid.Column="1" Name="RouteIntroDurationBox" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
								</Grid>
								<Border Classes="divider" />
								<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
									<StackPanel>
										<TextBlock Text="Color the route by speed" Classes="rowTitle" />
										<TextBlock Classes="rowHint" Text="Green when slow, through yellow and orange to red at the top speed." />
									</StackPanel>
									<ToggleSwitch Grid.Column="1" Name="RouteIntroColorBySpeedCheck" />
								</Grid>
								<Border Classes="divider" />
								<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
									<TextBlock Text="Units" Classes="rowTitle" VerticalAlignment="Center" />
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
										<RadioButton Name="RouteIntroMetricRadio" Content="Metric" GroupName="RouteIntroUnits" />
										<RadioButton Name="RouteIntroImperialRadio" Content="Imperial" GroupName="RouteIntroUnits" />
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<TextBlock Text="MAP" Classes="sectionLabel" />
						<Border Classes="settingsCard" Padding="16">
							<local:MapSourcePicker Name="RouteIntroMapSource" />
						</Border>

						<TextBlock Name="RouteIntroStatsLabel" Text="STATS TO SHOW" Classes="sectionLabel" />
						<Border Classes="settingsCard" Padding="16,12">
							<UniformGrid Columns="2" RowSpacing="4" ColumnSpacing="16">
								<CheckBox Name="RouteIntroDistanceCheck" Content="Total distance" />
								<CheckBox Name="RouteIntroMaxSpeedCheck" Content="Max speed" />
								<CheckBox Name="RouteIntroAvgSpeedCheck" Content="Average speed" />
								<CheckBox Name="RouteIntroDateCheck" Content="Date" />
								<CheckBox Name="RouteIntroDurationCheck" Content="Recording duration" />
								<CheckBox Name="RouteIntroElevationGainCheck" Content="Elevation gain" />
								<CheckBox Name="RouteIntroCameraModelCheck" Content="Camera model" />
							</UniformGrid>
						</Border>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>

			<!-- Interface -->
			<ScrollViewer Name="InterfacePanel" Classes="page hidden" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<StackPanel>
						<TextBlock Text="Interface" Classes="pageTitle" />
						<TextBlock Classes="pageSubtitle" Text="How the app looks and reads." />
					</StackPanel>

					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Theme" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="Applies right away; a few glows and gradients follow when their window opens again." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="ThemeCombo" SelectionChanged="OnThemeChanged" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Interface scale" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="On top of the system's display scaling. Needs a restart - with no file loaded the app restarts when you close Settings." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="InterfaceScaleCombo" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Time format" Classes="rowTitle" />
									<TextBlock Name="TimeFormatHint" Classes="rowHint" />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="TimeFormatCombo" SelectionChanged="OnTimeFormatChanged" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Layer rows" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="Layers the timeline under the preview shows before it scrolls." />
								</StackPanel>
								<NumericUpDown Grid.Column="1" Name="LayerRowsBox" Minimum="1" Maximum="12" Increment="1" FormatString="0" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- Behavior -->
			<ScrollViewer Name="BehaviorPanel" Classes="page hidden" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<StackPanel>
						<TextBlock Text="Behavior" Classes="pageTitle" />
						<TextBlock Classes="pageSubtitle" Text="Startup, projects, playback and monitors." />
					</StackPanel>

					<TextBlock Text="STARTUP" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Open the window where it was closed" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="Size, position, screen and maximized state. Off, it always starts maximized." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="RestoreWindowPlacementCheck" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Reopen the last project" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="The project last saved or opened. One you start the app with (a double-click) wins." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="ReopenLastProjectCheck" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Welcome guide" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="The first-run guide: tools, speed calibration, output folder and project files." />
								</StackPanel>
								<Button Grid.Column="1" Content="Open..." VerticalAlignment="Center" Click="OnWelcomeClick" />
							</Grid>
						</StackPanel>
					</Border>

					<TextBlock Text="PROJECTS" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<StackPanel Name="ProjectFilesGroup" IsVisible="False">
								<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
									<StackPanel>
										<TextBlock Text="Project files" Classes="rowTitle" />
										<TextBlock Name="ProjectAssociationText" Classes="rowHint" />
										<TextBlock Classes="rowHint" Text="Opens .ovproj files with this app on a double-click. Applies right away, for your user only." />
									</StackPanel>
									<Button Grid.Column="1" Name="ProjectAssociationButton" VerticalAlignment="Center" Click="OnProjectAssociationClick" />
								</Grid>
								<Border Classes="divider" />
							</StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Auto-save backup" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="A backup of the open project in the app's data folder - the project's own file changes only on Save." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="AutoSaveCombo" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Ask before closing during a render" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="Closing ends a running render and leaves a partial file." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="ConfirmCloseWhileRenderingCheck" />
							</Grid>
						</StackPanel>
					</Border>

					<TextBlock Text="PLAYBACK AND MONITORS" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Loop playback from startup" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="Loops the In/Out selection, or the whole recording. The Loop button (Q) toggles it any time." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="LoopByDefaultCheck" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Full screen preview" Classes="rowTitle" />
									<TextBlock Classes="rowHint" Text="The monitor F11 opens the preview on. Esc leaves it." />
								</StackPanel>
								<ComboBox Grid.Column="1" Name="PreviewMonitorCombo" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
								<StackPanel>
									<TextBlock Text="Second screen (F9)" Classes="rowTitle" />
									<TextBlock Classes="rowHint"
									           Text="A full screen window there: the log while nothing plays, the preview while it plays. Esc or F9 closes it." />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="SecondScreenCheck" IsCheckedChanged="OnSecondScreenChanged" />
							</Grid>
							<Grid Classes="settingRow" ColumnDefinitions="*,Auto" Margin="16,0,16,13">
								<TextBlock Text="Monitor" Classes="rowHint" VerticalAlignment="Center" Margin="0" />
								<ComboBox Grid.Column="1" Name="SecondScreenMonitorCombo" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<!-- About -->
			<ScrollViewer Name="AboutPanel" Classes="page hidden" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="28,22,28,28" Spacing="14">
					<Border Classes="settingsCard" Padding="18,16">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
							<Image Source="/Assets/OsmoOverlay.png" Width="48" Height="48" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
								<TextBlock Name="AppVersionText" Text="OsmoOverlay" FontSize="18" FontWeight="Bold" />
								<TextBlock Name="CoreVersionText" Text="Core" Classes="rowHint" Margin="0" />
							</StackPanel>
							<Button Grid.Column="2" Name="CheckForUpdatesButton" Content="Check for updates" VerticalAlignment="Center"
							        Click="OnCheckForUpdatesClick" />
						</Grid>
					</Border>

					<Border Classes="settingsCard">
						<Grid Classes="settingRow" ColumnDefinitions="*,Auto">
							<StackPanel>
								<TextBlock Text="Updates" Classes="rowTitle" />
								<TextBlock Name="AppUpdateText" Text="Checking for a new version..." Classes="rowHint" />
							</StackPanel>
							<Button Grid.Column="1" Name="AppUpdateButton" Classes="accent" IsVisible="False" VerticalAlignment="Center" Click="OnAppUpdateClick" />
						</Grid>
					</Border>

					<TextBlock Text="DEPENDENCIES" Classes="sectionLabel" />
					<Border Classes="settingsCard" Padding="16,14">
						<Grid Name="DependencyStatusGrid" ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="12" RowSpacing="8" />
					</Border>

					<TextBlock Text="PROJECT" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Classes="settingRow" ColumnDefinitions="Auto,*">
								<TextBlock Text="Author" Classes="rowTitle" Width="110" />
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<TextBlock Text="Sefinek &lt;" />
									<TextBlock Text="contact@sefinek.net" Classes="link" Tag="mailto:contact@sefinek.net" PointerPressed="OnLinkClick" />
									<TextBlock Text="&gt; (" />
									<TextBlock Text="https://sefinek.net" Classes="link" Tag="https://sefinek.net" PointerPressed="OnLinkClick" />
									<TextBlock Text=")" />
								</StackPanel>
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="Auto,*">
								<TextBlock Text="Repository" Classes="rowTitle" Width="110" />
								<TextBlock Grid.Column="1" Text="github.com/sefinek/osmo-overlay" Classes="link"
								           Tag="https://github.com/sefinek/osmo-overlay" PointerPressed="OnLinkClick" />
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="Auto,*">
								<TextBlock Text="License" Classes="rowTitle" Width="110" />
								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock TextWrapping="Wrap"
									           Text="Free for non-commercial use under the PolyForm Noncommercial License 1.0.0. The videos you make with it are yours - you can monetize them." />
									<TextBlock Text="Read the license" Classes="link" Tag="https://github.com/sefinek/osmo-overlay/blob/main/LICENSE"
									           PointerPressed="OnLinkClick" />
								</StackPanel>
							</Grid>
							<Border Classes="divider" />
							<Grid Classes="settingRow" ColumnDefinitions="Auto,*">
								<TextBlock Text="Configuration" Classes="rowTitle" Width="110" />
								<TextBlock Grid.Column="1" Name="ConfigLastUpdatedText" Text="Config last updated: -" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>
