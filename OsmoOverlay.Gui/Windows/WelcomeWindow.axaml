<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        xmlns:local="using:OsmoOverlay.Gui"
        x:Class="OsmoOverlay.Gui.WelcomeWindow"
        Width="1000" Height="680" MinWidth="900" MinHeight="560" CanResize="True"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="{x:Static local:AppAssets.Icon}"
        Title="{x:Static local:Strings.Welcome_WelcomeToOsmoOverlay}">

	<Window.Styles>
		<Style Selector="TextBlock">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="LineHeight" Value="21" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Button">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="MinHeight" Value="38" />
			<Setter Property="Padding" Value="16,8" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="StackPanel.step">
			<Setter Property="Spacing" Value="16" />
		</Style>
		<Style Selector="StackPanel.rowDetails">
			<Setter Property="Spacing" Value="2" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Padding" Value="16" />
		</Style>
		<Style Selector="Border.card > StackPanel">
			<Setter Property="Spacing" Value="12" />
		</Style>
		<Style Selector="StackPanel.step, Image.art">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.18" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TextBlock.stepTitle">
			<Setter Property="FontSize" Value="24" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="LineHeight" Value="30" />
		</Style>
		<Style Selector="TextBlock.stepLabel">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
		</Style>
		<Style Selector="TextBlock.lead">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
			<Setter Property="LineHeight" Value="23" />
		</Style>
		<Style Selector="TextBlock.fieldLabel">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
		</Style>
		<Style Selector="TextBlock.rowTitle">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.cardTitle">
			<Setter Property="FontSize" Value="16" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.rowText">
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
		</Style>
		<Style Selector="TextBlock.hint, TextBlock.infoLabel">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
		</Style>
		<Style Selector="TextBlock.caption">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="LineHeight" Value="18" />
		</Style>
		<Style Selector="TextBlock.statusText">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Border.iconBadge">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
		<Style Selector="Border.iconBadge > local|IconView">
			<Setter Property="Width" Value="18" />
			<Setter Property="Height" Value="18" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
		</Style>
		<Style Selector="Border.iconBadge > local|IconView.noticeIcon">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
		</Style>
		<Style Selector="Button.ghost">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
		</Style>
		<Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="Button.wizard">
			<Setter Property="MinWidth" Value="88" />
		</Style>
		<Style Selector="Grid.wizardFooter > Button">
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="14,5" />
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="260,*">
		<Border Grid.Column="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
					<GradientStop Offset="0" Color="{StaticResource AccentSubtleColor}" />
					<GradientStop Offset="0.65" Color="{StaticResource SurfaceSunkenColor}" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid RowDefinitions="*,Auto" Margin="20,24">
				<StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14">
					<Panel Width="220" Height="220">
						<Ellipse Width="220" Height="220" Opacity="0.6">
							<Ellipse.Fill>
								<RadialGradientBrush>
									<GradientStop Offset="0" Color="{StaticResource AccentCalloutBorderColor}" />
									<GradientStop Offset="1" Color="{StaticResource AccentGlowFadeColor}" />
								</RadialGradientBrush>
							</Ellipse.Fill>
						</Ellipse>
						<Image Name="WelcomeArt" Classes="art" Source="{local:AssetImage Path=Welcome/Welcome.webp}" />
						<Image Name="CameraArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Camera.webp}" />
						<Image Name="ToolsArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Tools.webp}" />
						<Image Name="HardwareArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Hardware.webp}" />
						<Image Name="SpeedArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Speed.webp}" />
						<Image Name="MapArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Map.webp}" />
						<Image Name="PreferencesArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Preferences.webp}" />
						<Image Name="FinishArt" Classes="art" Opacity="0" Source="{local:AssetImage Path=Welcome/Support.webp}" />
					</Panel>
					<TextBlock Text="OsmoOverlay" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
					<StackPanel Name="StepDots" Orientation="Horizontal" HorizontalAlignment="Center" />
				</StackPanel>
				<Border Grid.Row="1" HorizontalAlignment="Center" Padding="10,3" CornerRadius="10"
				        Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
					<TextBlock Name="VersionText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
				</Border>
			</Grid>
		</Border>

		<Grid Grid.Column="1" RowDefinitions="*,Auto">
			<ScrollViewer Name="StepScrollViewer" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="24,20,24,20" Spacing="10">
					<TextBlock Name="StepLabel" Classes="stepLabel" />

					<Grid>
						<StackPanel Name="WelcomeStep" Classes="step">
							<TextBlock Text="{x:Static local:Strings.Welcome_WelcomeToOsmoOverlay}" Classes="stepTitle" />
							<TextBlock Classes="lead"
							           Text="{x:Static local:Strings.Welcome_BurnSpeedHeadingTiltAnd}" />
							<Border Classes="card">
								<StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Settings_License}" Classes="cardTitle" />
										<TextBlock Text="{x:Static local:Strings.Settings_FreeForNonCommercialUse}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.License_CommercialRestrictionsTitle}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.License_CommercialRestrictions}" Classes="rowText" />
									</StackPanel>
									<TextBlock Text="{x:Static local:Strings.License_OrganizationExceptions}" Classes="rowText" />
									<TextBlock Text="{x:Static local:Strings.License_CommercialContact}" Classes="rowText" />
									<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
										<Button Content="{x:Static local:Strings.License_ContactByEmail}"
										        Tag="mailto:contact@sefinek.net" Click="OnLinkButtonClick" />
										<Button Content="{x:Static local:Strings.Settings_ReadTheLicense}"
										        Tag="https://github.com/sefinek/osmo-overlay/blob/main/LICENSE" Click="OnLinkButtonClick" />
									</StackPanel>
								</StackPanel>
							</Border>
							<Border Classes="card">
								<StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Welcome_ConnectionTitle}" Classes="cardTitle" />
										<TextBlock Text="{x:Static local:Strings.Welcome_ConnectionDescription}" Classes="rowText" />
									</StackPanel>
									<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
										<TextBlock Text="DNS (server.arcgisonline.com)" />
										<TextBlock Name="ConnectionDnsStatus" Grid.Column="1" Classes="statusText" Text="{x:Static local:Strings.Welcome_Checking}" />
										<TextBlock Grid.Row="1" Text="{x:Static local:Strings.Welcome_ConnectionHttpsLabel}" />
										<TextBlock Name="ConnectionHttpsStatus" Grid.Row="1" Grid.Column="1" Classes="statusText" Text="{x:Static local:Strings.Welcome_Checking}" />
									</Grid>
									<TextBlock Name="ConnectionHint" Classes="rowText" />
									<Button Name="ConnectionRetryButton" Content="{x:Static local:Strings.Welcome_ConnectionRetry}" HorizontalAlignment="Right"
									        Classes="wizard" Click="OnConnectionRetryClick" />
								</StackPanel>
							</Border>
							<Border Classes="card" Margin="0,4,0,0">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Border Classes="iconBadge">
										<local:IconView Data="{StaticResource IconInfo}" Classes="noticeIcon" />
									</Border>
									<TextBlock Grid.Column="1" Classes="rowText"
									           Text="{x:Static local:Strings.Welcome_EverythingHereCanBeChanged}" />
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Name="CameraStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Welcome_SupportedCameras}" Classes="stepTitle" />
							<TextBlock Classes="lead"
							           Text="{x:Static local:Strings.Welcome_OsmoOverlayReadsTheTelemetryYour}" />
							<Border Classes="card" Margin="0,4,0,0">
								<StackPanel>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
										<Border Classes="iconBadge">
											<local:IconView Data="{StaticResource IconCamera}" />
										</Border>
										<StackPanel Grid.Column="1" Classes="rowDetails">
											<TextBlock Text="DJI Osmo Action" Classes="rowTitle" />
											<TextBlock Classes="rowText"
											           Text="{x:Static local:Strings.Welcome_TestedOnTheAction6}" />
										</StackPanel>
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
										<Border Classes="iconBadge">
											<local:IconView Data="{StaticResource IconSphere}" />
										</Border>
										<StackPanel Grid.Column="1" Classes="rowDetails">
											<TextBlock Text="Insta360" Classes="rowTitle" />
											<TextBlock Classes="rowText"
											           Text="{x:Static local:Strings.Welcome_360InsvRecordingsTestedOn}" />
										</StackPanel>
									</Grid>
								</StackPanel>
							</Border>
							<Border Classes="card">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Border Classes="iconBadge">
										<local:IconView Data="{StaticResource IconInfo}" Classes="noticeIcon" />
									</Border>
									<TextBlock Grid.Column="1" Classes="rowText"
									           Text="{x:Static local:Strings.Welcome_UseTheOriginalFilesFrom}" />
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Name="ToolsStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Common_Tools}" Classes="stepTitle" />
							<TextBlock Classes="lead"
							           Text="{x:Static local:Strings.Welcome_OsmoOverlayRendersWithFFmpegExifTool}" />
							<StackPanel Name="ToolRows" Spacing="10" Margin="0,4,0,0" />
							<TextBlock Name="ToolsHint" Classes="hint" />
						</StackPanel>

						<StackPanel Name="HardwareStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Welcome_YourComputer}" Classes="stepTitle" />
							<TextBlock Classes="lead" Text="{x:Static local:Strings.Welcome_HardwareLead}" />
							<StackPanel Name="HardwareRows" Spacing="10" Margin="0,2,0,0" />
							<StackPanel Spacing="10">
								<TextBlock Name="HardwareHint" Classes="rowText" TextAlignment="Center" />
								<Button Name="BenchmarkButton" Content="{x:Static local:Strings.Welcome_RunBenchmark}" Classes="wizard" IsVisible="False" HorizontalAlignment="Center"
								        Click="OnBenchmarkClick" />
							</StackPanel>
						</StackPanel>

						<StackPanel Name="SpeedStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Common_SpeedCalibration}" Classes="stepTitle" />
							<TextBlock Classes="lead"
							           Text="{x:Static local:Strings.Welcome_SpeedFromACameraS}" />
							<local:SpeedCalibrationEditor Name="SpeedEditor" Margin="0,4,0,0" />
							<Button Content="{x:Static local:Strings.Calibration_LoadPreview}" HorizontalAlignment="Center"
							        Click="OnCalibrationPreviewClick" />
							<Expander HorizontalAlignment="Stretch" Background="{StaticResource SurfaceBrush}"
							          BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Padding="16">
								<Expander.Resources>
									<StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="SurfaceBrush" />
									<StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
									<StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="ControlPressedBrush" />
									<StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="CardBorderBrush" />
									<StaticResource x:Key="ExpanderHeaderBorderBrushPointerOver" ResourceKey="ControlBorderHoverBrush" />
									<StaticResource x:Key="ExpanderHeaderBorderBrushPressed" ResourceKey="CardBorderBrush" />
									<StaticResource x:Key="ExpanderHeaderForeground" ResourceKey="TextPrimaryBrush" />
									<StaticResource x:Key="ExpanderHeaderForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
									<StaticResource x:Key="ExpanderHeaderForegroundPressed" ResourceKey="TextPrimaryBrush" />
									<StaticResource x:Key="ExpanderChevronForeground" ResourceKey="AccentHoverBrush" />
									<StaticResource x:Key="ExpanderChevronForegroundPointerOver" ResourceKey="AccentHoverBrush" />
									<StaticResource x:Key="ExpanderChevronForegroundPressed" ResourceKey="AccentBrush" />
									<StaticResource x:Key="ExpanderChevronBackgroundPointerOver" ResourceKey="SubtleFillBrush" />
									<StaticResource x:Key="ExpanderChevronBackgroundPressed" ResourceKey="SubtleFillBrush" />
								</Expander.Resources>
								<Expander.Header>
									<TextBlock Text="{x:Static local:Strings.Calibration_FaqTitle}" Classes="cardTitle" />
								</Expander.Header>
								<StackPanel Spacing="10">
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqAccuracyQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqAccuracyAnswer}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqObstaclesQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqObstaclesAnswer}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqSpeedQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqSpeedAnswer}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqReferenceQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqReferenceAnswer}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqLimitsQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqLimitsAnswer}" Classes="rowText" />
									</StackPanel>
									<StackPanel Classes="rowDetails">
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqCivilianQuestion}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Calibration_FaqCivilianAnswer}" Classes="rowText" />
									</StackPanel>
									<Button HorizontalAlignment="Left" Margin="0,4,0,0"
									        Tag="https://www.gps.gov/gps-accuracy" Click="OnLinkButtonClick">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<TextBlock Text="{x:Static local:Strings.Calibration_FaqSource}" VerticalAlignment="Center" />
											<local:IconView Data="{StaticResource IconExternalLink}" Width="18" Height="18" VerticalAlignment="Center" />
										</StackPanel>
									</Button>
								</StackPanel>
							</Expander>
						</StackPanel>

						<StackPanel Name="MapStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Welcome_MapTitle}" Classes="stepTitle" />
							<TextBlock Classes="lead" Text="{x:Static local:Strings.Welcome_MapLead}" />
							<Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,2,0,8">
								<StackPanel Grid.Column="0" Spacing="4">
									<RadioButton Name="SatelliteChoice" GroupName="mapStyle" HorizontalAlignment="Center">
										<TextBlock Text="{x:Static local:Strings.Welcome_MapSatellite}" Classes="rowTitle" />
									</RadioButton>
									<Border CornerRadius="6" ClipToBounds="True" Height="96" Background="{StaticResource SurfaceSunkenBrush}" Cursor="Hand"
									        Tag="Satellite" PointerPressed="OnMapPreviewPressed">
										<Panel>
											<TextBlock Name="SatellitePreviewStatus" Classes="rowText" TextAlignment="Center" Margin="8"
											           HorizontalAlignment="Center" VerticalAlignment="Center" />
											<Image Name="SatellitePreview" Stretch="UniformToFill" />
										</Panel>
									</Border>
									<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_MapSatelliteHint}" />
									<TextBlock Name="SatellitePreviewCredit" Classes="rowText caption" IsVisible="False" />
								</StackPanel>
								<StackPanel Grid.Column="1" Spacing="4">
									<RadioButton Name="StreetsChoice" GroupName="mapStyle" HorizontalAlignment="Center">
										<TextBlock Text="{x:Static local:Strings.Welcome_MapStreets}" Classes="rowTitle" />
									</RadioButton>
									<Border CornerRadius="6" ClipToBounds="True" Height="96" Background="{StaticResource SurfaceSunkenBrush}" Cursor="Hand"
									        Tag="Streets" PointerPressed="OnMapPreviewPressed">
										<Panel>
											<TextBlock Name="StreetsPreviewStatus" Classes="rowText" TextAlignment="Center" Margin="8"
											           HorizontalAlignment="Center" VerticalAlignment="Center" />
											<Image Name="StreetsPreview" Stretch="UniformToFill" />
										</Panel>
									</Border>
									<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_MapStreetsHint}" />
									<TextBlock Name="StreetsPreviewCredit" Classes="rowText caption" IsVisible="False" />
								</StackPanel>
							</Grid>
							<TextBlock Name="MapOwnProviderHint" Classes="rowText" IsVisible="False" Margin="0,-4,0,0" />
							<Border Classes="card">
								<StackPanel>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
										<Border Classes="iconBadge">
											<local:IconView Data="{StaticResource IconInfo}" Classes="noticeIcon" />
										</Border>
										<StackPanel Grid.Column="1" Classes="rowDetails">
											<TextBlock Text="{x:Static local:Strings.Welcome_MapKeyLabel}" Classes="rowTitle" />
											<TextBlock Text="{x:Static local:Strings.Welcome_MapRuleWithKey}" Classes="rowText" />
										</StackPanel>
									</Grid>
									<StackPanel Spacing="8">
										<TextBox Name="EsriKeyBox" PasswordChar="•" PlaceholderText="{x:Static local:Strings.MapSource_PasteYourApiKey}"
										         TextChanged="OnEsriKeyTextChanged" LostFocus="OnEsriKeyLostFocus" />
										<TextBlock Name="ArcGisLink" Classes="link" HorizontalAlignment="Center" TextAlignment="Center"
										           Text="{x:Static local:Strings.Welcome_MapGetKey}" PointerPressed="OnGetKeyPressed">
											<FlyoutBase.AttachedFlyout>
												<Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="guide">
													<local:EsriKeyGuide />
												</Flyout>
											</FlyoutBase.AttachedFlyout>
										</TextBlock>
										<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_MapKeyHint}" />
									</StackPanel>
									<Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<local:IconView Name="MapRuleIcon" Data="{StaticResource IconWarning}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"
											                Foreground="{StaticResource WarningBrush}" />
											<TextBlock Name="MapRuleText" Grid.Column="1" Text="{x:Static local:Strings.Welcome_MapRuleWithoutKey}" Classes="rowText" />
										</Grid>
									</Border>
								</StackPanel>
							</Border>
						</StackPanel>

						<StackPanel Name="PreferencesStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Welcome_RenderingAndFiles}" Classes="stepTitle" />
							<TextBlock Classes="lead" Text="{x:Static local:Strings.Welcome_DefaultsForTheFirstRender}" />
							<Border Classes="card" Margin="0,4,0,0">
								<StackPanel>
									<CheckBox Name="SmoothGpsCheck">
										<StackPanel Classes="rowDetails">
											<TextBlock Text="{x:Static local:Strings.Common_SmoothGpsDerivedMotion}" />
											<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_SmoothGpsHint}" />
										</StackPanel>
									</CheckBox>
									<CheckBox Name="WatermarkCheck">
										<StackPanel Classes="rowDetails">
											<TextBlock Text="{x:Static local:Strings.Welcome_ShowAttributionWatermark}" />
											<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_WatermarkHint}" />
										</StackPanel>
									</CheckBox>
									<CheckBox Name="ProjectAssociationCheck">
										<StackPanel Classes="rowDetails">
											<TextBlock Text="{x:Static local:Strings.Welcome_OpenOvprojProjectFilesWith}" />
											<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_ProjectAssociationHint}" />
										</StackPanel>
									</CheckBox>
								</StackPanel>
							</Border>
							<StackPanel Spacing="6" Margin="0,4,0,0">
								<TextBlock Text="{x:Static local:Strings.Welcome_DefaultOutputFolder}" Classes="fieldLabel" />
								<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
									<TextBox Grid.Column="0" Name="OutputFolderBox" IsReadOnly="True" PlaceholderText="{x:Static local:Strings.Welcome_NextToTheSourceFile}" />
									<Button Grid.Column="1" Content="{x:Static local:Strings.Common_Browse}" Click="OnBrowseOutputClick" />
									<Button Grid.Column="2" Content="{x:Static local:Strings.Welcome_Clear}" Click="OnClearOutputClick" />
								</Grid>
								<TextBlock Classes="rowText" Text="{x:Static local:Strings.Welcome_OutputFolderHint}" />
								<StackPanel Name="OutputDiskPanel" Spacing="4" IsVisible="False">
									<TextBlock Name="OutputDiskSpaceText" />
									<TextBlock Name="OutputDiskWarningText" Classes="rowText" Foreground="{StaticResource WarningBrush}" IsVisible="False" />
								</StackPanel>
							</StackPanel>
						</StackPanel>

						<StackPanel Name="FinishStep" Classes="step" Opacity="0">
							<TextBlock Text="{x:Static local:Strings.Welcome_YouReAllSet}" Classes="stepTitle" />
							<TextBlock Classes="lead" Text="{x:Static local:Strings.Welcome_ThisIsWhatWillBe}" />
							<Border Classes="card">
								<Grid Name="SummaryGrid" ColumnDefinitions="*,*" ColumnSpacing="20" RowSpacing="12" />
							</Border>
							<TextBlock Classes="lead" Margin="0,4,0,0"
							           Text="{x:Static local:Strings.Welcome_OsmoOverlayIsMadeByOne}" />
							<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
								<Button Content="{x:Static local:Strings.Welcome_StarOnGitHub}" Tag="https://github.com/sefinek/osmo-overlay" Click="OnLinkButtonClick" />
								<Button Content="{x:Static local:Strings.Welcome_SupportOnKoFi}" Tag="https://ko-fi.com/sefinek" Click="OnLinkButtonClick" />
							</StackPanel>
							<WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<TextBlock Text="{x:Static local:Strings.Welcome_OtherWays}" Classes="hint" Margin="0,0,8,0" />
								<TextBlock Text="GitHub Sponsors" Classes="link" Margin="0,0,10,0" Tag="https://github.com/sponsors/sefinek" PointerPressed="OnLinkPressed" />
								<TextBlock Text="Open Collective" Classes="link" Margin="0,0,10,0" Tag="https://opencollective.com/sefinek24" PointerPressed="OnLinkPressed" />
								<TextBlock Text="PayPal" Classes="link" Tag="https://www.paypal.me/sefinek24" PointerPressed="OnLinkPressed" />
							</WrapPanel>
						</StackPanel>
					</Grid>
				</StackPanel>
			</ScrollViewer>

			<Border Grid.Row="1" Padding="24,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
				<Grid Classes="wizardFooter" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
					<Button Grid.Column="0" Name="SkipButton" Content="{x:Static local:Strings.Common_Skip}" Classes="ghost" Click="OnSkipClick" />
					<Button Grid.Column="2" Name="BackButton" Content="{x:Static local:Strings.Common_Back}" Classes="wizard" Click="OnBackClick" />
					<Button Grid.Column="3" Name="NextButton" Content="{x:Static local:Strings.Welcome_Next}" Classes="wizard" Click="OnNextClick" />
					<Button Grid.Column="4" Name="OpenRecordingButton" Content="{x:Static local:Strings.Common_OpenARecording}" Classes="accent wizard" IsVisible="False"
					        Click="OnOpenRecordingClick" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
