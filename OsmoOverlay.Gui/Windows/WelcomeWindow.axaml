<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
        xmlns:local="using:OsmoOverlay.Gui"
        x:Class="OsmoOverlay.Gui.WelcomeWindow"
        Width="860" Height="560" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="/Assets/OsmoOverlay.ico"
        Title="Welcome to OsmoOverlay">

	<Window.Styles>
		<Style Selector="StackPanel.step, Image.art">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.18" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TextBlock.stepTitle">
			<Setter Property="FontSize" Value="24" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style Selector="TextBlock.stepLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
		</Style>
		<Style Selector="TextBlock.lead">
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="21" />
		</Style>
		<Style Selector="TextBlock.fieldLabel">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
		</Style>
		<Style Selector="TextBlock.rowTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.rowText">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.iconBadge">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
		<Style Selector="Button.ghost">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
		</Style>
		<Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="Button.wizard, Button.ghost">
			<Setter Property="Height" Value="34" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.wizard">
			<Setter Property="MinWidth" Value="88" />
			<Setter Property="Padding" Value="16,7" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="260,*">
		<Border Grid.Column="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
					<GradientStop Offset="0" Color="{StaticResource AccentSubtleColor}" />
					<GradientStop Offset="0.65" Color="{StaticResource SurfaceSunkenColor}" />
				</LinearGradientBrush>
			</Border.Background>
			<Grid RowDefinitions="*,Auto" Margin="20,24">
				<StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="14">
					<Panel Width="200" Height="200">
						<Ellipse Width="180" Height="180" Opacity="0.6">
							<Ellipse.Fill>
								<RadialGradientBrush>
									<GradientStop Offset="0" Color="{StaticResource AccentCalloutBorderColor}" />
									<GradientStop Offset="1" Color="{StaticResource AccentGlowFadeColor}" />
								</RadialGradientBrush>
							</Ellipse.Fill>
						</Ellipse>
						<Image Name="WelcomeArt" Classes="art" Source="/Assets/Welcome/Welcome.webp" />
						<Image Name="CameraArt" Classes="art" Opacity="0" Source="/Assets/Welcome/Camera.webp" />
						<Image Name="ToolsArt" Classes="art" Opacity="0" Source="/Assets/Welcome/Tools.webp" />
						<Image Name="SpeedArt" Classes="art" Opacity="0" Source="/Assets/Welcome/Speed.webp" />
						<Image Name="PreferencesArt" Classes="art" Opacity="0" Source="/Assets/Welcome/Preferences.webp" />
						<Image Name="FinishArt" Classes="art" Opacity="0" Source="/Assets/Welcome/Support.webp" />
					</Panel>
					<TextBlock Text="OsmoOverlay" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
					<StackPanel Name="StepDots" Orientation="Horizontal" HorizontalAlignment="Center" />
				</StackPanel>
				<Border Grid.Row="1" HorizontalAlignment="Center" Padding="10,3" CornerRadius="10"
				        Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
					<TextBlock Name="VersionText" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
				</Border>
			</Grid>
		</Border>

		<Grid Grid.Column="1" RowDefinitions="*,Auto">
			<StackPanel Grid.Row="0" Margin="24,20,24,12" Spacing="6">
				<TextBlock Name="StepLabel" Classes="stepLabel" />

				<Grid>
					<StackPanel Name="WelcomeStep" Classes="step" Spacing="12">
						<TextBlock Text="Welcome to OsmoOverlay" Classes="stepTitle" />
						<TextBlock Classes="lead"
						           Text="Burn speed, heading, tilt and more onto footage from your DJI Osmo Action or Insta360 camera." />
						<TextBlock Classes="lead"
						           Text="A few quick steps get you ready for the first render: your camera, the tools, speed calibration and where videos go." />
						<Border Classes="card" Margin="0,6,0,0" Padding="14,10">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
								<local:IconView Data="{StaticResource IconInfo}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
								                Foreground="{StaticResource AccentHoverBrush}" />
								<TextBlock Grid.Column="1" Classes="rowText" FontSize="13"
								           Text="Everything here can be changed later in Settings, and this guide can be opened again from there. Enter goes to the next step, Esc closes the guide." />
							</Grid>
						</Border>
					</StackPanel>

					<StackPanel Name="CameraStep" Classes="step" Opacity="0" Spacing="12">
						<TextBlock Text="Your camera" Classes="stepTitle" />
						<TextBlock Classes="lead"
						           Text="OsmoOverlay reads the telemetry your camera saves inside every recording - no extra files needed." />
						<Border Classes="card" Padding="14,12" Margin="0,4,0,0">
							<StackPanel Spacing="12">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Border Classes="iconBadge">
										<local:IconView Data="{StaticResource IconCamera}" Width="14" Height="14" Foreground="{StaticResource AccentHoverBrush}"
										                HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="DJI Osmo Action" Classes="rowTitle" />
										<TextBlock Classes="rowText"
										           Text="Tested on the Action 6 and Action 5 Pro; other models (e.g. Action 4) should work too. Pick the .MP4 files." />
									</StackPanel>
								</Grid>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Border Classes="iconBadge">
										<local:IconView Data="{StaticResource IconSphere}" Width="14" Height="14" Foreground="{StaticResource AccentHoverBrush}"
										                HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="Insta360" Classes="rowTitle" />
										<TextBlock Classes="rowText"
										           Text="360° .insv recordings (tested on the X4) become a flat view you can aim. GPS isn't read from them yet." />
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>
						<Border Classes="card" Padding="14,10">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
								<local:IconView Data="{StaticResource IconInfo}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
								                Foreground="{StaticResource AccentHoverBrush}" />
								<TextBlock Grid.Column="1" Classes="rowText" FontSize="13"
								           Text="Use the original files from the card - a copy exported from DJI Mimo loses the telemetry. For speed, route and map, record with the DJI GPS Bluetooth Remote (or your phone's GPS through DJI Mimo) and wait for a satellite fix first." />
							</Grid>
						</Border>
					</StackPanel>

					<StackPanel Name="ToolsStep" Classes="step" Opacity="0" Spacing="12">
						<TextBlock Text="Tools" Classes="stepTitle" />
						<TextBlock Classes="lead"
						           Text="OsmoOverlay renders with FFmpeg. ExifTool is optional and only used for cameras whose telemetry it can't read on its own." />
						<StackPanel Name="ToolRows" Spacing="8" Margin="0,4,0,0" />
						<TextBlock Name="ToolsHint" Classes="hint" />
					</StackPanel>

					<StackPanel Name="SpeedStep" Classes="step" Opacity="0" Spacing="10">
						<TextBlock Text="Speed calibration" Classes="stepTitle" />
						<TextBlock Classes="lead"
						           Text="Speed from a camera's GPS is never 100% exact. Peaks tend to come out low, and the signal quality moves it either way." />
						<TextBlock Classes="hint"
						           Text="If you know what your vehicle really does, raise every shown speed by a percentage. It's a rough correction, so judge it over several rides rather than one peak." />
						<StackPanel Spacing="6" Margin="0,4,0,0">
							<TextBlock Text="Correction (%)" Classes="fieldLabel" />
							<NumericUpDown Name="CorrectionBox" Minimum="0" Increment="0.5" FormatString="0.#" HorizontalAlignment="Stretch" />
						</StackPanel>
						<Border Classes="card" Padding="14" Margin="0,4,0,0">
							<StackPanel Spacing="8">
								<TextBlock Text="Not sure? Work it out from a known speed" FontWeight="SemiBold" />
								<Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
									<StackPanel Grid.Column="0" Spacing="4">
										<TextBlock Text="Real top speed" Classes="fieldLabel" />
										<NumericUpDown Name="RealSpeedBox" Watermark="e.g. 25" Minimum="1" Maximum="500" Increment="1" FormatString="0.#"
										               HorizontalAlignment="Stretch" ValueChanged="OnKnownSpeedChanged" />
									</StackPanel>
									<StackPanel Grid.Column="1" Spacing="4">
										<TextBlock Text="Shown by the overlay" Classes="fieldLabel" />
										<NumericUpDown Name="ShownSpeedBox" Watermark="e.g. 22" Minimum="1" Maximum="500" Increment="1" FormatString="0.#"
										               HorizontalAlignment="Stretch" ValueChanged="OnKnownSpeedChanged" />
									</StackPanel>
									<Button Grid.Column="2" Name="ApplyCalculationButton" Content="Apply" IsEnabled="False" VerticalAlignment="Bottom"
									        Click="OnApplyCalculationClick" />
								</Grid>
								<TextBlock Name="CalculationText" Classes="rowText" FontSize="13" />
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Name="PreferencesStep" Classes="step" Opacity="0" Spacing="12">
						<TextBlock Text="Rendering and files" Classes="stepTitle" />
						<TextBlock Classes="lead" Text="Defaults for the first render. You can change any of them later." />
						<Border Classes="card" Padding="14,8" Margin="0,4,0,0">
							<StackPanel Spacing="2">
								<CheckBox Name="SmoothGpsCheck" Content="Smooth GPS-derived motion" />
								<CheckBox Name="WatermarkCheck" Content="Show attribution watermark" />
								<CheckBox Name="ProjectAssociationCheck" Content="Open .ovproj project files with OsmoOverlay" />
							</StackPanel>
						</Border>
						<StackPanel Spacing="6" Margin="0,4,0,0">
							<TextBlock Text="Default output folder" Classes="fieldLabel" />
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
								<TextBox Grid.Column="0" Name="OutputFolderBox" IsReadOnly="True" PlaceholderText="Next to the source file" />
								<Button Grid.Column="1" Content="Browse..." Click="OnBrowseOutputClick" />
								<Button Grid.Column="2" Content="Clear" Click="OnClearOutputClick" />
							</Grid>
						</StackPanel>
					</StackPanel>

					<StackPanel Name="FinishStep" Classes="step" Opacity="0" Spacing="12">
						<TextBlock Text="You're all set" Classes="stepTitle" />
						<TextBlock Classes="lead" Text="This is what will be saved:" />
						<Border Classes="card" Padding="14,10">
							<Grid Name="SummaryGrid" ColumnDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="6" />
						</Border>
						<TextBlock Classes="lead" Margin="0,4,0,0"
						           Text="OsmoOverlay is made by one person in spare time and is free for non-commercial use. A star on GitHub helps others find it, and support keeps the project going." />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Content="Star on GitHub" Tag="https://github.com/sefinek/osmo-overlay" Click="OnLinkButtonClick" />
							<Button Content="Support on Ko-fi" Tag="https://ko-fi.com/sefinek" Click="OnLinkButtonClick" />
						</StackPanel>
						<WrapPanel Orientation="Horizontal">
							<TextBlock Text="Other ways:" Classes="hint" Margin="0,0,8,0" />
							<TextBlock Text="GitHub Sponsors" Classes="link" Margin="0,0,10,0" Tag="https://github.com/sponsors/sefinek" PointerPressed="OnLinkPressed" />
							<TextBlock Text="Open Collective" Classes="link" Margin="0,0,10,0" Tag="https://opencollective.com/sefinek24" PointerPressed="OnLinkPressed" />
							<TextBlock Text="PayPal" Classes="link" Tag="https://www.paypal.me/sefinek24" PointerPressed="OnLinkPressed" />
						</WrapPanel>
					</StackPanel>
				</Grid>
			</StackPanel>

			<Border Grid.Row="1" Padding="24,12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
					<Button Grid.Column="0" Name="SkipButton" Content="Skip" Classes="ghost" Click="OnSkipClick" />
					<Button Grid.Column="2" Name="BackButton" Content="Back" Classes="wizard" Click="OnBackClick" />
					<Button Grid.Column="3" Name="NextButton" Content="Next" Classes="wizard" Click="OnNextClick" />
					<Button Grid.Column="4" Name="OpenRecordingButton" Content="Open a recording" Classes="accent wizard" IsVisible="False"
					        Click="OnOpenRecordingClick" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
