<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OsmoOverlay.Gui"
        x:Class="OsmoOverlay.Gui.ExternalTrackWindow"
        Width="720" MinWidth="620" Height="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}"
        Icon="{x:Static local:AppAssets.Icon}" Title="{x:Static local:Strings.Track_Title}">
	<Window.Styles>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="Margin" Value="4,0,0,-4" />
		</Style>
		<Style Selector="ToggleSwitch">
			<Setter Property="OnContent" Value="" />
			<Setter Property="OffContent" Value="" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.settingsCard">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
		<Style Selector="Border.divider">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
		</Style>
		<Style Selector="StackPanel.settingBlock">
			<Setter Property="Margin" Value="16,13" />
			<Setter Property="Spacing" Value="10" />
		</Style>
		<Style Selector="TextBlock.rowTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.rowHint">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="18" />
		</Style>
		<Style Selector="TextBlock.pageSubtitle">
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</Window.Styles>

	<Grid Margin="20" RowDefinitions="*,Auto,Auto" RowSpacing="12">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Name="Editor" Spacing="14" Margin="0,0,12,0">
				<TextBlock Text="{x:Static local:Strings.Track_Help}" Classes="pageSubtitle" />

				<TextBlock Text="{x:Static local:Strings.Track_FileSection}" Classes="sectionLabel" />
				<Border Classes="settingsCard">
					<StackPanel>
						<Grid Margin="16,13" ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<TextBox Name="PathBox" IsReadOnly="True" PlaceholderText="{x:Static local:Strings.Track_FileType}" />
							<Button Grid.Column="1" Content="{x:Static local:Strings.Common_Browse}" Click="OnBrowseClick" />
						</Grid>
						<TextBlock Classes="rowHint" Margin="16,0,16,13" Text="{x:Static local:Strings.Track_FitPreferred}" />
						<StackPanel Name="TrackDetails" IsVisible="False">
							<Border Classes="divider" />
							<StackPanel Classes="settingBlock" Spacing="2">
								<TextBlock Text="{x:Static local:Strings.Track_Range}" Classes="rowTitle" />
								<TextBlock Name="TrackInfo" Classes="rowHint" />
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Border>

				<StackPanel Name="SyncSection" Spacing="14" IsVisible="False">
					<TextBlock Text="{x:Static local:Strings.Track_FirstAnchor}" Classes="sectionLabel" />
					<Border Classes="settingsCard">
						<StackPanel>
							<StackPanel Classes="settingBlock">
								<local:TrackAnchorEditor Name="FirstAnchor" />
							</StackPanel>
							<Border Classes="divider" />
							<StackPanel Classes="settingBlock" Spacing="6">
								<Button Name="EstimateButton" Content="{x:Static local:Strings.Track_Estimate}" Click="OnEstimateClick" IsEnabled="False" HorizontalAlignment="Center" />
								<TextBlock Name="EstimateInfo" IsVisible="False" Classes="rowHint" TextAlignment="Center" />
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Margin="16,13" ColumnDefinitions="*,Auto" ColumnSpacing="24">
								<StackPanel>
									<TextBlock Text="{x:Static local:Strings.Track_SecondAnchor}" Classes="rowTitle" />
									<TextBlock Text="{x:Static local:Strings.Track_SecondAnchorHint}" Classes="rowHint" Margin="0,3,0,0" />
								</StackPanel>
								<ToggleSwitch Grid.Column="1" Name="UseSecond" />
							</Grid>
							<Border Classes="divider" IsVisible="{Binding #UseSecond.IsChecked}" />
							<StackPanel Name="SecondPanel" Classes="settingBlock" IsVisible="{Binding #UseSecond.IsChecked}">
								<local:TrackAnchorEditor Name="SecondAnchor" />
							</StackPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<TextBlock Text="{x:Static local:Strings.Track_Gaps}" Classes="rowHint" Margin="4,0" />
			</StackPanel>
		</ScrollViewer>

		<TextBlock Grid.Row="1" Name="ProblemText" IsVisible="False" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />

		<Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
			<Button Name="RemoveButton" Content="{x:Static local:Strings.Track_Remove}" Classes="danger" Click="OnRemoveClick" />
			<Button Grid.Column="2" Content="{x:Static local:Strings.Common_Cancel}" IsCancel="True" Click="OnCancelClick" />
			<Button Grid.Column="3" Name="ApplyButton" Content="{x:Static local:Strings.Track_Apply}" Classes="accent" IsDefault="True" Click="OnApplyClick" IsEnabled="False" />
		</Grid>
	</Grid>
</Window>
