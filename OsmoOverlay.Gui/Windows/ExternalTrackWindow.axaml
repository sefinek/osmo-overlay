<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OsmoOverlay.Gui"
        x:Class="OsmoOverlay.Gui.ExternalTrackWindow"
        Width="720" MinWidth="620" Height="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}"
        Icon="{x:Static local:AppAssets.Icon}" Title="{x:Static local:Strings.Track_Title}">
	<Window.Styles>
		<Style Selector="TextBlock.sectionLabel">
			<Setter Property="Margin" Value="4,0,0,-4" />
		</Style>
		<Style Selector="ToggleSwitch">
			<Setter Property="OnContent" Value="" />
			<Setter Property="OffContent" Value="" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.settingsCard">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
		<Style Selector="Border.divider">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
		</Style>
		<Style Selector="StackPanel.settingBlock">
			<Setter Property="Margin" Value="16,13" />
			<Setter Property="Spacing" Value="10" />
		</Style>
		<Style Selector="TextBlock.rowTitle">
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.rowHint">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="18" />
		</Style>
		<Style Selector="TextBlock.pageSubtitle">
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.stepLabel">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="LetterSpacing" Value="1" />
			<Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
		</Style>
		<Style Selector="TextBlock.stepTitle">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style Selector="TextBlock.summaryLabel">
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>
		<Style Selector="TextBlock.summaryValue">
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</Window.Styles>

	<Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
		<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
			<StackPanel Spacing="2">
				<TextBlock Name="StepLabel" Classes="stepLabel" />
				<TextBlock Name="StepTitle" Classes="stepTitle" />
			</StackPanel>
			<StackPanel Grid.Column="1" Name="StepDots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
		</Grid>

		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
			<Panel Name="Pages" Margin="0,0,12,0">
				<StackPanel Name="FileStep" Spacing="14">
					<TextBlock Text="{x:Static local:Strings.Track_FileHelp}" Classes="pageSubtitle" />
					<Border Classes="settingsCard">
						<StackPanel>
							<Grid Margin="16,13" ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Name="PathBox" IsReadOnly="True" PlaceholderText="{x:Static local:Strings.Track_FileType}" />
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
									<Button Name="PhoneButton" Content="{x:Static local:Strings.Track_FindInPhone}" Click="OnPhoneClick" IsVisible="False" />
									<Button Content="{x:Static local:Strings.Common_Browse}" Click="OnBrowseClick" />
								</StackPanel>
							</Grid>
							<TextBlock Classes="rowHint" Margin="16,0,16,13" Text="{x:Static local:Strings.Track_FitPreferred}" />
							<StackPanel Name="TrackDetails" IsVisible="False">
								<Border Classes="divider" />
								<StackPanel Classes="settingBlock" Spacing="2">
									<TextBlock Text="{x:Static local:Strings.Track_Range}" Classes="rowTitle" />
									<TextBlock Name="TrackInfo" Classes="rowHint" />
									<TextBlock Name="TrackStats" Classes="rowHint" />
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Name="SyncStep" Spacing="14" IsVisible="False">
					<Border Classes="settingsCard">
						<StackPanel Classes="settingBlock" Spacing="4">
							<TextBlock Name="VerdictText" Classes="rowTitle" TextWrapping="Wrap" />
							<TextBlock Name="VerdictHint" Classes="rowHint" />
						</StackPanel>
					</Border>

					<Border Classes="settingsCard">
						<StackPanel Classes="settingBlock" Spacing="12">
							<RadioButton Name="AutoMode" GroupName="Mode" IsChecked="True">
								<StackPanel Spacing="2">
									<TextBlock Text="{x:Static local:Strings.Track_ModeAuto}" Classes="rowTitle" />
									<TextBlock Text="{x:Static local:Strings.Track_ModeAutoHint}" Classes="rowHint" />
								</StackPanel>
							</RadioButton>
							<RadioButton Name="ManualMode" GroupName="Mode">
								<StackPanel Spacing="2">
									<TextBlock Text="{x:Static local:Strings.Track_ModeManual}" Classes="rowTitle" />
									<TextBlock Text="{x:Static local:Strings.Track_ModeManualHint}" Classes="rowHint" />
								</StackPanel>
							</RadioButton>
						</StackPanel>
					</Border>

					<StackPanel Name="ManualPanel" Spacing="14" IsVisible="{Binding #ManualMode.IsChecked}">
						<TextBlock Text="{x:Static local:Strings.Track_FirstAnchor}" Classes="sectionLabel" />
						<Border Classes="settingsCard">
							<StackPanel Classes="settingBlock">
								<local:TrackAnchorEditor Name="FirstAnchor" />
							</StackPanel>
						</Border>

						<Border Classes="settingsCard">
							<StackPanel>
								<Grid Margin="16,13" ColumnDefinitions="*,Auto" ColumnSpacing="24">
									<StackPanel>
										<TextBlock Text="{x:Static local:Strings.Track_SecondAnchor}" Classes="rowTitle" />
										<TextBlock Text="{x:Static local:Strings.Track_SecondAnchorHint}" Classes="rowHint" Margin="0,3,0,0" />
									</StackPanel>
									<ToggleSwitch Grid.Column="1" Name="UseSecond" />
								</Grid>
								<Border Classes="divider" IsVisible="{Binding #UseSecond.IsChecked}" />
								<StackPanel Classes="settingBlock" IsVisible="{Binding #UseSecond.IsChecked}">
									<local:TrackAnchorEditor Name="SecondAnchor" />
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>
				</StackPanel>

				<StackPanel Name="SummaryStep" Spacing="14" IsVisible="False">
					<Border Classes="settingsCard">
						<Grid Margin="16,13" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
							<TextBlock Text="{x:Static local:Strings.Track_SumTrack}" Classes="summaryLabel" />
							<TextBlock Grid.Column="1" Name="SumTrack" Classes="summaryValue" />
							<TextBlock Grid.Row="1" Text="{x:Static local:Strings.Track_Range}" Classes="summaryLabel" />
							<TextBlock Grid.Row="1" Grid.Column="1" Name="SumRange" Classes="summaryValue" />
							<TextBlock Grid.Row="2" Text="{x:Static local:Strings.Track_SumAlignment}" Classes="summaryLabel" />
							<TextBlock Grid.Row="2" Grid.Column="1" Name="SumMethod" Classes="summaryValue" />
							<TextBlock Grid.Row="3" Text="{x:Static local:Strings.Track_SumCoverage}" Classes="summaryLabel" />
							<TextBlock Grid.Row="3" Grid.Column="1" Name="SumCoverage" Classes="summaryValue" />
						</Grid>
					</Border>
					<TextBlock Name="SummaryHint" Classes="rowHint" Margin="4,0" />
					<TextBlock Text="{x:Static local:Strings.Track_Gaps}" Classes="rowHint" Margin="4,0" />
				</StackPanel>
			</Panel>
		</ScrollViewer>

		<StackPanel Grid.Row="2">
			<TextBlock Name="LoadingText" IsVisible="False" Classes="rowHint" Margin="0,12,0,0" />
			<TextBlock Name="ProblemText" IsVisible="False" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0" />
			<ProgressBar Name="Busy" IsIndeterminate="True" IsVisible="False" Margin="0,12,0,0" />
		</StackPanel>

		<Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
			<Button Name="RemoveButton" Content="{x:Static local:Strings.Track_Remove}" Classes="danger" Click="OnRemoveClick" />
			<Button Grid.Column="2" Content="{x:Static local:Strings.Common_Cancel}" IsCancel="True" Click="OnCancelClick" />
			<Button Grid.Column="3" Name="BackButton" Content="{x:Static local:Strings.Common_Back}" Click="OnBackClick" IsVisible="False" />
			<Button Grid.Column="4" Name="NextButton" Classes="accent" IsDefault="True" Click="OnNextClick" IsEnabled="False" />
		</Grid>
	</Grid>
</Window>
