<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OsmoOverlay.Gui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="OsmoOverlay.Gui.CompareVideosWindow"
        Width="900" Height="620" CanResize="True"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="15"
        Icon="/Assets/OsmoOverlay.ico"
        Title="{x:Static local:Strings.Common_CompareVideos}">

	<Window.Styles>
		<Style Selector="TextBlock.infoLabel">
			<Setter Property="Margin" Value="0,5" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Margin" Value="0,4,0,0" />
		</Style>
		<Style Selector="TextBlock.rowLabel">
			<Setter Property="Opacity" Value="0.6" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.cellValue">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</Window.Styles>

	<DockPanel Margin="20">
		<StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12" HorizontalAlignment="Center">
			<TextBlock Text="{x:Static local:Strings.Common_CompareVideos}" Classes="infoLabel" Margin="0" TextAlignment="Center" HorizontalAlignment="Center" />
			<TextBlock Classes="hint" Margin="0,0,0,4" TextAlignment="Center" HorizontalAlignment="Center"
			           Text="{x:Static local:Strings.CompareVideos_PickUpTo6Files}" />
			<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
				<Button Name="AddFilesButton" Content="{x:Static local:Strings.CompareVideos_AddVideoS}" Click="OnAddFilesClick" />
				<Button Name="ClearAllButton" Content="{x:Static local:Strings.Common_ClearAll}" Click="OnClearAllClick" />
				<Button Name="CopyAsTextButton" Content="{x:Static local:Strings.CompareVideos_CopyAsMarkdown}" Click="OnCopyAsTextClick" />
				<Button Name="SaveToFileButton" Content="{x:Static local:Strings.CompareVideos_SaveToFile}" Click="OnSaveToFileClick" />
				<CheckBox Name="ShowOnlyDifferencesCheck" Content="{x:Static local:Strings.CompareVideos_ShowOnlyDifferences}" Click="OnShowOnlyDifferencesClick"
				          VerticalAlignment="Center" Margin="8,0,0,0" />
			</StackPanel>
		</StackPanel>

		<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<Panel>
				<TextBlock Name="EmptyStateText" Classes="hint" FontSize="14"
				           Text="{x:Static local:Strings.CompareVideos_NoFilesAddedYetClick}"
				           HorizontalAlignment="Center" VerticalAlignment="Center" />
				<TextBlock Name="NoDifferencesText" Classes="hint" FontSize="14"
				           Text="{x:Static local:Strings.CompareVideos_NoDifferencesBetweenTheAdded}"
				           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
				<Grid Name="CompareGrid" />
			</Panel>
		</ScrollViewer>
	</DockPanel>
</Window>
