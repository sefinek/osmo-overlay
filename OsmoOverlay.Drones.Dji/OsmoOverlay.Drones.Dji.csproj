<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OsmoOverlay.Drones.Dji</AssemblyName>
    <RootNamespace>OsmoOverlay.Drones.Dji</RootNamespace>

    <AssemblyTitle>OsmoOverlay DJI drones</AssemblyTitle>
    <Description>DJI drone support for OsmoOverlay: the flight log (DJI Fly / GO 4 FlightRecord) read as a track for any recording - position, height, speed and battery, decrypted with the keys DJI hands out for a log.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OsmoOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsmoOverlay.Core\OsmoOverlay.Core.csproj" />
  </ItemGroup>

</Project>
