<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>OsmoOverlay.Core</AssemblyName>
    <RootNamespace>OsmoOverlay.Core</RootNamespace>

    <AssemblyTitle>OsmoOverlay Core</AssemblyTitle>
    <Description>Telemetry processing, HUD rendering, 360 reframing and the ffmpeg pipeline - the camera formats plug in (OsmoOverlay.Cameras.*).</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_SHA)' != ''">
    <BuildCommit>$(GITHUB_SHA.Substring(0, 7))</BuildCommit>
  </PropertyGroup>

  <ItemGroup Condition="'$(BUILD_DATE)' != ''">
    <AssemblyMetadata Include="BuildDate" Value="$(BUILD_DATE)" />
    <AssemblyMetadata Include="Commit" Value="$(BuildCommit)" Condition="'$(BuildCommit)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OsmoOverlay.Tests" />
    <InternalsVisibleTo Include="OsmoOverlay.Cameras.Dji" />
    <InternalsVisibleTo Include="OsmoOverlay.Cameras.Insta360" />
    <InternalsVisibleTo Include="OsmoOverlay.Cameras.GoPro" />
    <InternalsVisibleTo Include="OsmoOverlay.Drones.Dji" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\CoreStrings.resx"
                      StronglyTypedLanguage="C#"
                      StronglyTypedNamespace="OsmoOverlay.Core.Localization"
                      StronglyTypedClassName="CoreStrings"
                      StronglyTypedFileName="$(IntermediateOutputPath)CoreStrings.g.cs" />
    <Compile Include="$(IntermediateOutputPath)CoreStrings.g.cs"
             Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(IntermediateOutputPath)CoreStrings.g.cs')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="NLog" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
