  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>

</Project>
