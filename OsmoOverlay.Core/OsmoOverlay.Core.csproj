<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>OsmoOverlay.Core</AssemblyName>
    <RootNamespace>OsmoOverlay.Core</RootNamespace>

    <AssemblyTitle>OsmoOverlay Core</AssemblyTitle>
    <Description>Telemetry processing, HUD rendering, 360 reframing and the ffmpeg pipeline - the camera formats plug in (OsmoOverlay.Cameras.*).</Description>
